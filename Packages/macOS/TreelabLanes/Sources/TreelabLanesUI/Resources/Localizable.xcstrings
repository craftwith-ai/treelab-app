    "treelab.account.signInDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No password: a one-time link arrives in your inbox. The free trial starts at your first sign-in, no card needed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de mot de passe : un lien à usage unique arrive dans ta boîte. L’essai gratuit démarre à ta première connexion, sans carte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Passwort: Ein Einmal-Link kommt in dein Postfach. Die kostenlose Testphase beginnt bei deiner ersten Anmeldung, ohne Karte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin contraseña: te llega a la bandeja de entrada un enlace de un solo uso. La prueba gratuita empieza con tu primer inicio de sesión, sin tarjeta."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا كلمة مرور: يصلك رابط لمرة واحدة في بريدك. تبدأ التجربة المجانية عند أول تسجيل دخول لك، دون بطاقة."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需密码：一次性链接会发到你的收件箱。免费试用从你首次登录时开始，无需信用卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需密碼：一次性連結會寄到你的收件匣。免費試用從你首次登入時開始，無需信用卡。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호는 필요 없습니다: 일회용 링크가 받은편지함으로 옵니다. 무료 체험은 처음 로그인할 때 시작되며, 카드가 필요 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードは不要です。1 回限りのリンクが受信トレイに届きます。無料トライアルは初回サインイン時に始まり、カードは不要です。"
          }
        }
      }
    },
