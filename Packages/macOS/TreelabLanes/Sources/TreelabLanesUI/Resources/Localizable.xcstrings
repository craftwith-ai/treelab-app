    "treelab.welcome.ginkgo.keyDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظه lab في سلسلة مفاتيح Mac، ولا يُرسل أبدًا إلى Treelab."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "lab ga čuva u privjesku ključeva na Macu, nikad ne ide u Treelab."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt af lab i Macens nøglering, aldrig sendt til Treelab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von lab im Schlüsselbund des Mac gespeichert, nie an Treelab gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in the Mac’s keychain by lab, never sent to Treelab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada por lab en el llavero del Mac, nunca enviada a Treelab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangée dans le trousseau du Mac par lab, jamais envoyée à Treelab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conservata da lab nel portachiavi del Mac, mai inviata a Treelab."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "lab が Mac のキーチェーンに保存し、Treelab に送られることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "lab រក្សាទុកវាក្នុង Keychain របស់ Mac មិនដែលផ្ញើទៅ Treelab ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "lab이 Mac 키체인에 저장하며, Treelab으로는 절대 보내지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret av lab i nøkkelringen på Macen, aldri sendt til Treelab."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisany przez lab w pęku kluczy Maca, nigdy nie wysyłany do Treelab."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada nas Chaves do Mac pelo lab, nunca enviada ao Treelab."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "lab хранит его в связке ключей Mac; в Treelab он не отправляется никогда."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "lab เก็บไว้ในพวงกุญแจของ Mac และไม่เคยส่งไปที่ Treelab"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "lab tarafından Mac'in anahtar zincirinde saklanır, asla Treelab'a gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "lab зберігає його у в’язці ключів Mac; до Treelab він ніколи не надсилається."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 lab 存入 Mac 的钥匙串，绝不会发送给 Treelab。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 lab 存入 Mac 的鑰匙圈，絕不會傳送給 Treelab。"
          }
        }
      }
    },
