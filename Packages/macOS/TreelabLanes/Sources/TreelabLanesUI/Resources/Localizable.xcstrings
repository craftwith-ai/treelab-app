    "treelab.account.notice.invalidQuiet": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تمتد ساعات الهدوء من وقت إلى وقت آخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tihi sati idu od jednog vremena do drugog."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stille timer går fra ét tidspunkt til et andet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ruhezeiten reichen von einer Uhrzeit bis zu einer anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quiet hours go from one time to another."
