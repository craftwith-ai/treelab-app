    "treelab.ginkgo.keep.on": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدأ Ginkgo مع Treelab والميكروفون مغلق، ويبقى في الخلفية."
