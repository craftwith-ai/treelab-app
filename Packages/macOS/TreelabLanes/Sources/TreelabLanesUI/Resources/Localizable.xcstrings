    "treelab.privacy.openai.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوتك، وما يقرؤه Ginkgo من مساراتك ليجيبك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj glas i ono što Ginkgo pročita iz tvojih staza da ti odgovori"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din stemme og det, Ginkgo læser i dine spor for at svare dig"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme und was Ginkgo aus deinen Spuren liest, um dir zu antworten"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice, and what Ginkgo reads of your lanes to answer you"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz, y lo que Ginkgo lee de tus carriles para responderte"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta voix, et ce que Ginkgo lit de tes couloirs pour te répondre"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua voce, e quello che Ginkgo legge delle tue corsie per risponderti"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの声と、Ginkgo が答えるために読むレーンの内容"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំឡេងរបស់អ្នក និងអ្វីដែល Ginkgo អានពីផ្លូវការងាររបស់អ្នក ដើម្បីឆ្លើយអ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리, 그리고 Ginkgo가 답하려고 읽는 통로 내용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen din, og det Ginkgo leser i sporene dine for å svare deg"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój głos i to, co Ginkgo czyta z twoich torów, żeby ci odpowiedzieć"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua voz, e o que o Ginkgo lê das suas trilhas para responder a você"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой голос и то, что Ginkgo читает в твоих дорожках, чтобы ответить тебе"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงของคุณ และสิ่งที่ Ginkgo อ่านจากเลนของคุณเพื่อตอบคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesin ve Ginkgo'nun sana yanıt vermek için kulvarlarından okudukları"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій голос і те, що Ginkgo читає з твоїх доріжок, щоб відповісти тобі"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的声音，以及 Ginkgo 为回答你而读取的通道内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聲音，以及 Ginkgo 為回答你而讀取的通道內容"
          }
        }
      }
    },
    "treelab.privacy.openai.when": {
