    "treelab.privacy.claude.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما تعرضه عليه مساراتك ليعمل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ono što mu tvoje staze pokazuju da bi radio"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det, dine spor viser den for at arbejde"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was deine Spuren ihm zum Arbeiten zeigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What your lanes show it to work"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que tus carriles le muestran para trabajar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce que tes couloirs lui montrent pour travailler"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quello che le tue corsie gli mostrano per lavorare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作業のためにレーンが見せる内容"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីដែលផ្លូវការងាររបស់អ្នកបង្ហាញវា ដើម្បីធ្វើការ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "작업을 위해 통로가 보여 주는 내용"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det sporene dine viser den for å jobbe"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To, co twoje tory mu pokazują, żeby mógł pracować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que suas trilhas mostram a ele para trabalhar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "То, что твои дорожки показывают ему для работы"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่เลนของคุณให้ Claude ดูเพื่อทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulvarlarının çalışması için ona gösterdikleri"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Те, що твої доріжки показують йому для роботи"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的通道为了工作给它看的内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的通道為了工作給它看的內容"
          }
        }
      }
    },
    "treelab.privacy.claude.when": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يعمل مسار، بحساب Claude الخاص بك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad staza radi, s tvojim Claude nalogom"
