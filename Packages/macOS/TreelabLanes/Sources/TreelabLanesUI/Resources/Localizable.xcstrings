    "treelab.privacy.safeguards": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب إغلاق مسار أن تقول «نعم» بصوت عالٍ خلال 120 ثانية. من دون «نعم» منك لا يحدث شيء. لا يتصرف Ginkgo إلا بطلبك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvaranje staze traži tvoje „da“ naglas, u roku od 120 sekundi. Bez tvog „da“ ništa se ne dešava. Ginkgo radi samo kad ti zatražiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukning af et spor kræver dit »ja«, sagt højt inden for 120 sekunder. Uden dit »ja« sker der intet. Ginkgo handler kun, når du beder om det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Spur zu schließen braucht dein gesprochenes „ja“, innerhalb von 120 Sekunden. Ohne dein „ja“ passiert nichts. Ginkgo handelt nur auf deine Bitte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing a lane needs your spoken “yes”, within 120 seconds. Without your “yes”, nothing happens. Ginkgo acts only when you ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar un carril necesita tu «sí» en voz alta, en menos de 120 segundos. Sin tu «sí», no pasa nada. Ginkgo solo actúa cuando se lo pides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer un couloir demande ton « oui » à voix haute, dans les 120 secondes. Sans ton « oui », rien ne se passe. Ginkgo n’agit que sur ta demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiudere una corsia richiede il tuo “sì” detto a voce, entro 120 secondi. Senza il tuo “sì”, non succede niente. Ginkgo agisce solo quando glielo chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンを終了するには、120 秒以内に声で「はい」と言う必要があります。「はい」がなければ何も起きません。Ginkgo は頼まれたときだけ動きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការបិទផ្លូវការងារត្រូវការ «បាទ/ចាស» ដោយសំឡេងរបស់អ្នក ក្នុងរយៈពេល 120 វិនាទី។ បើគ្មាន «បាទ/ចាស» ពីអ្នក គ្មានអ្វីកើតឡើងទេ។ Ginkgo ធ្វើតែពេលអ្នកស្នើប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로를 닫으려면 120초 안에 소리 내어 “네”라고 말해야 합니다. “네”가 없으면 아무 일도 일어나지 않습니다. Ginkgo는 요청할 때만 움직입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Å lukke et spor krever at du sier «ja» høyt innen 120 sekunder. Uten ditt «ja» skjer ingenting. Ginkgo gjør bare noe når du ber om det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamknięcie toru wymaga twojego „tak” powiedzianego na głos w ciągu 120 sekund. Bez twojego „tak” nic się nie dzieje. Ginkgo działa tylko na twoją prośbę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Fechar uma trilha exige o seu “sim” em voz alta, em até 120 segundos. Sem o seu “sim”, nada acontece. O Ginkgo só age quando você pede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы закрыть дорожку, нужно твоё «да» вслух в течение 120 секунд. Без твоего «да» ничего не произойдёт. Ginkgo действует, только когда ты просишь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การปิดเลนต้องได้ยินคุณพูดว่า “ใช่” ภายใน 120 วินาที ถ้าไม่พูด “ใช่” จะไม่มีอะไรเกิดขึ้น Ginkgo จะทำก็ต่อเมื่อคุณขอเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kulvarı kapatmak için 120 saniye içinde sesli “evet” demen gerekir. “Evet” demezsen hiçbir şey olmaz. Ginkgo yalnızca sen isteyince harekete geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб закрити доріжку, потрібне твоє «так» уголос протягом 120 секунд. Без твого «так» нічого не станеться. Ginkgo діє, лише коли ти просиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭通道需要你在 120 秒内大声说“是”。没有你的“是”，什么都不会发生。Ginkgo 只在你要求时行动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉通道需要你在 120 秒內大聲說「是」。沒有你的「是」，什麼都不會發生。Ginkgo 只在你要求時行動。"
          }
        }
      }
    },
