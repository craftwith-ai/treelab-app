    "treelab.ginkgo.did.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء حتى الآن: لا يتصرف Ginkgo إلا بطلبك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Još ništa: Ginkgo radi samo kad ti zatražiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet endnu: Ginkgo handler kun, når du beder om det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nichts: Ginkgo handelt nur auf deine Bitte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing yet: Ginkgo only acts when you ask."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada por ahora: Ginkgo solo actúa cuando se lo pides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien pour l’instant : Ginkgo n’agit que sur ta demande."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora niente: Ginkgo agisce solo quando glielo chiedi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "まだありません。Ginkgo は頼まれたときだけ動きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មិនទាន់មានអ្វីទេ៖ Ginkgo ធ្វើតែពេលអ្នកស្នើប៉ុណ្ណោះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 없음: Ginkgo는 요청할 때만 움직입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting ennå: Ginkgo gjør bare noe når du ber om det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeszcze nic: Ginkgo działa tylko na twoją prośbę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada ainda: o Ginkgo só age quando você pede."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пока ничего: Ginkgo действует, только когда ты просишь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่มี: Ginkgo จะทำก็ต่อเมื่อคุณขอเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir şey yok: Ginkgo yalnızca sen isteyince harekete geçer."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Поки нічого: Ginkgo діє, лише коли ти просиш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时没有：Ginkgo 只在你要求时行动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫時沒有：Ginkgo 只在你要求時行動。"
          }
        }
      }
    },
