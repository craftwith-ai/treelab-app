        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications declined: you can allow them in System Settings › Notifications."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications refusées : tu peux les autoriser dans Réglages Système › Notifications."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen abgelehnt: Du kannst sie in Systemeinstellungen › Mitteilungen erlauben."
          }
        },
        "es": {
          "stringUnit": {
