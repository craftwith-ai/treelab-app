          "stringUnit": {
            "state": "translated",
            "value": "เมื่อ Ginkgo ฟัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ne zaman dinler"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли Ginkgo слухає"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 何时在听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 何時在聽"
          }
        }
      }
    },
    "treelab.welcome.ginkgo.mic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليسمعك Ginkgo، فقط عندما تقرر. سيطلبه منك Ginkgo في أول محادثة لك، ليسمعك. لا يستمع Treelab أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Da te Ginkgo čuje, samo kad ti odlučiš. Ginkgo će te pitati za njega pri prvom razgovoru, da te čuje. Treelab nikad ne sluša."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at Ginkgo kan høre dig, kun når du bestemmer det. Ginkgo beder dig om den ved din første samtale for at kunne høre dig. Treelab lytter aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Ginkgo dich hört, nur wenn du es entscheidest. Ginkgo fragt dich beim ersten Gespräch danach, um dich zu hören. Treelab hört nie zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Ginkgo to hear you, only when you decide. Ginkgo will ask you for it at your first conversation, to hear you. Treelab never listens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que Ginkgo te oiga, solo cuando tú decidas. Ginkgo te lo pedirá en tu primera conversación, para oírte. Treelab nunca escucha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que Ginkgo t’entende, seulement quand tu le décides. Ginkgo te le demandera à ta première conversation, pour t’entendre. Treelab n’écoute jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché Ginkgo ti senta, solo quando lo decidi tu. Ginkgo te lo chiederà alla tua prima conversazione, per sentirti. Treelab non ascolta mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが決めたときだけ、Ginkgo があなたの声を聞くためです。Ginkgo は最初の会話のとき、あなたの声を聞くためにマイクの許可を求めます。Treelab が聞くことはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីឲ្យ Ginkgo ឮអ្នក តែពេលអ្នកសម្រេចប៉ុណ្ណោះ។ Ginkgo នឹងសុំវាពីអ្នកនៅការសន្ទនាលើកដំបូង ដើម្បីឮអ្នក។ Treelab មិនដែលស្តាប់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 원할 때만 Ginkgo가 내 목소리를 들을 수 있도록. Ginkgo가 첫 대화 때 내 목소리를 들으려고 마이크 권한을 요청합니다. Treelab은 절대 듣지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For at Ginkgo skal høre deg, bare når du bestemmer det. Ginkgo ber deg om den ved den første samtalen, for å høre deg. Treelab lytter aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żeby Ginkgo cię słyszał, tylko wtedy, gdy zdecydujesz. Ginkgo poprosi cię o niego przy pierwszej rozmowie, żeby cię słyszeć. Treelab nigdy nie słucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para o Ginkgo ouvir você, só quando você decide. O Ginkgo vai pedir acesso ao microfone na sua primeira conversa, para ouvir você. O Treelab nunca ouve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы Ginkgo слышал тебя — только когда ты решишь. Ginkgo попросит доступ к микрофону при первом разговоре, чтобы слышать тебя. Treelab никогда не слушает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้ Ginkgo ได้ยินคุณ เฉพาะเมื่อคุณเลือกเท่านั้น Ginkgo จะขออนุญาตใช้ไมโครโฟนในการสนทนาครั้งแรกของคุณ เพื่อให้ได้ยินคุณ Treelab ไม่ฟังเสียงคุณเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo'nun seni duyması için, yalnızca sen karar verdiğinde. Ginkgo seni duyabilmek için ilk sohbetinde mikrofon izni isteyecek. Treelab asla dinlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб Ginkgo чув тебе — лише коли ти вирішиш. Ginkgo попросить доступ до мікрофона під час першої розмови, щоб чути тебе. Treelab ніколи не слухає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Ginkgo 听到你，只在你决定的时候。Ginkgo 会在你第一次对话时请求使用麦克风，以便听到你。Treelab 从不收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Ginkgo 聽到你，只在你決定的時候。Ginkgo 會在你第一次對話時請求使用麥克風，以便聽到你。Treelab 從不收聽。"
          }
        }
      }
    },
    "treelab.welcome.ginkgo.micTitle": {
      "extractionState": "manual",
      "localizations": {
