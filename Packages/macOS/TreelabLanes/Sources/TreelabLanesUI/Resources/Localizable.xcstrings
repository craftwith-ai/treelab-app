    "treelab.privacy.listen.command.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone opens when you click, and closes when you say “stop” or after a silence."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro s’ouvre quand tu cliques, et se ferme quand tu dis « stop » ou après un silence."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon geht an, wenn du klickst, und aus, wenn du „stopp“ sagst oder nach einer Stille."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se abre cuando haces clic y se cierra cuando dices «stop» o tras un silencio."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح الميكروفون عندما تنقر، ويُغلق عندما تقول «توقف» أو بعد صمت."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击时麦克风打开，说“停”或沉默一会儿后关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊時麥克風開啟，說「停」或沉默一會兒後關閉。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 마이크가 켜지고, “그만”이라고 하거나 잠시 조용하면 꺼집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするとマイクがオンになり、「ストップ」と言うか、しばらく黙るとオフになります。"
          }
        }
      }
    },
