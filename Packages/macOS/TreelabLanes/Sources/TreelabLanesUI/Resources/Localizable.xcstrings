    "treelab.ginkgo.outcome.expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تأتِ «نعم» في الوقت: لم يُغلق شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nema „da“ na vrijeme: ništa nije zatvoreno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet »ja« i tide: intet er lukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein „ja“ rechtzeitig: nichts wird geschlossen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No “yes” in time: nothing is closed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún «sí» a tiempo: no se cierra nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de « oui » à temps : rien n’est fermé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun “sì” in tempo: non si chiude niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間内に「はい」がありませんでした。何も終了しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មាន «បាទ/ចាស» ទាន់ពេល៖ គ្មានអ្វីត្រូវបានបិទទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제때 “네”가 없었습니다: 아무것도 닫지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikke noe «ja» i tide: ingenting er lukket."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak „tak” na czas: nic nie zamknięto."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhum “sim” a tempo: nada foi fechado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Да» не прозвучало вовремя: ничего не закрыто."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ยิน “ใช่” ทันเวลา: ไม่มีอะไรถูกปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamanında “evet” gelmedi: hiçbir şey kapatılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Так» не прозвучало вчасно: нічого не закрито."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有及时说“是”：什么都没关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有及時說「是」：什麼都沒關閉。"
          }
        }
      }
    },
    "treelab.ginkgo.presence.absent": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo لا يعمل: «تكلّم» يشغّله."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ne radi: „Pričaj“ ga pokreće."
          }
