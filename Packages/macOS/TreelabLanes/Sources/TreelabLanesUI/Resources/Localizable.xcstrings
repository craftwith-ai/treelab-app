    "treelab.account.signOutEverywhere.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق كل جلسات حسابك، بما فيها هذا الـ Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatvara sve sesije tvog naloga, uključujući ovaj Mac."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukker alle sessioner på din konto, også på denne Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beendet alle Sitzungen deines Kontos, auch auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes every session of your account, this Mac included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra todas las sesiones de tu cuenta, incluido este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme toutes les sessions de ton compte, ce Mac compris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiude tutte le sessioni del tuo account, compreso questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac を含め、アカウントのすべてのセッションを終了します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បិទគ្រប់វគ្គនៃគណនីរបស់អ្នក រួមទាំង Mac នេះ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac을 포함해 계정의 모든 세션을 닫습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lukker alle øktene på kontoen din, også på denne Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamyka wszystkie sesje twojego konta, także na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Encerra todas as sessões da sua conta, inclusive neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Закрывает все сеансы твоего аккаунта, включая этот Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดทุกเซสชันของบัญชีคุณ รวมถึง Mac เครื่องนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac dahil, hesabının tüm oturumlarını kapatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Закриває всі сеанси твого акаунта, зокрема на цьому Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭你账户的所有登录会话，包括这台 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉你帳號的所有登入工作階段，包括這台 Mac。"
          }
        }
      }
    },
