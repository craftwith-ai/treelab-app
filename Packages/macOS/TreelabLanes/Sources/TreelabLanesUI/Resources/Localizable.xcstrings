    "treelab.welcome.word.lane.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عمل في مشروعك، له Claude خاص به."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posao u tvom projektu, koji ima svoj Claude."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En opgave i dit projekt, med sin egen Claude."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorhaben in deinem Projekt, mit seinem eigenen Claude."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A piece of work in your project, with its own Claude."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trabajo de tu proyecto, con su propio Claude."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un chantier de ton projet, avec son propre Claude."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un lavoro del tuo progetto, con il suo Claude."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロジェクト内のひとつの作業。専用の Claude が付きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការងារមួយក្នុងគម្រោងរបស់អ្នក ជាមួយ Claude ផ្ទាល់ខ្លួន។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로젝트 안의 작업 하나로, 전용 Claude가 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En oppgave i prosjektet ditt, med sin egen Claude."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadanie w twoim projekcie, z własnym Claude."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma frente de trabalho do seu projeto, com seu próprio Claude."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельная задача в твоём проекте, со своим Claude."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "งานชิ้นหนึ่งในโปรเจกต์ของคุณ ที่มี Claude ของตัวเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Projendeki bir iş, kendi Claude'uyla."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окреме завдання в твоєму проєкті, зі своїм Claude."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你项目中的一项工作，有自己专属的 Claude。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你專案中的一項工作，有自己專屬的 Claude。"
          }
        }
      }
    },
