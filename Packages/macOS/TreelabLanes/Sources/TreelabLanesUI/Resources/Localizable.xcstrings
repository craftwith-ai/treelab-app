        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sconto team: −%@ su ogni postazione da %lld postazioni"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チーム割引：%2$lld シート以上で全シート −%1$@"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បញ្ចុះតម្លៃក្រុម៖ −%@ លើសិទ្ធិប្រើនីមួយៗ ចាប់ពី %lld សិទ្ធិប្រើឡើងទៅ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "팀 할인: 시트 %2$lld개부터 모든 시트 −%1$@"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Teamrabatt: −%@ på alle plasser fra %lld plasser"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rabat zespołowy: −%@ na każde stanowisko od %lld stanowisk"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desconto de equipe: −%@ em todos os assentos a partir de %lld assentos"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скидка для команды: −%@ на каждое место от %lld мест"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่วนลดสำหรับทีม: −%@ ทุกสิทธิ์ เมื่อมีตั้งแต่ %lld สิทธิ์ขึ้นไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekip indirimi: her koltukta −%@, %lld koltuktan itibaren"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знижка для команди: −%@ на кожне місце від %lld місць"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "团队折扣：%2$lld 个席位起，每个席位 −%1$@"
