    "treelab.welcome.word.batch.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step of a lane, from the question to the delivery."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étape d’un couloir, de la question à la livraison."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt einer Spur, von der Frage bis zur Lieferung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etapa de un carril, de la pregunta a la entrega."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوة من مسار، من السؤال إلى التسليم."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通道中的一步，从提问到交付。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通道中的一步，從提問到交付。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로의 한 단계로, 질문부터 결과물 전달까지입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンのひとつの段階。質問から引き渡しまで。"
          }
        }
      }
    },
    "treelab.welcome.word.feed.detail": {
      "comment": "Feed is a Treelab name, not translated.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything waiting for you, one request at a time."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui t’attend, une demande à la fois."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was auf dich wartet, eine Anfrage nach der anderen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que te espera, una solicitud cada vez."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما ينتظرك، طلبًا تلو الآخر."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有在等你的事项，一次一个请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有在等你的事項，一次一個請求。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나를 기다리는 모든 것을 요청 하나씩."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた待ちのものすべてを、リクエスト 1 件ずつ。"
          }
        }
      }
    },
