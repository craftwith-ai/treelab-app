            "value": "Henüz oturum açılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід ще не виконано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "尚未登入。"
          }
        }
      }
    },
    "treelab.account.stopAnytime": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "توقّف متى شئت: تبقى نسختك لك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prestani kad hoćeš: tvoja verzija ostaje tvoja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop, når du vil: din version forbliver din."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hör auf, wann du willst: Deine Version bleibt deine."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop whenever you like: your version stays yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para cuando quieras: tu versión sigue siendo tuya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrête quand tu veux : ta version reste à toi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Smetti quando vuoi: la tua versione resta tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "いつでも解約できます。お使いのバージョンはそのまま使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈប់ពេលណាក៏បាន៖ កំណែរបស់អ្នកនៅតែជារបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "언제든 해지할 수 있습니다: 쓰던 버전은 그대로 내 것입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopp når du vil: versjonen din forblir din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrezygnuj, kiedy chcesz: twoja wersja pozostaje twoja."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Pare quando quiser: sua versão continua sendo sua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можешь остановиться когда угодно: твоя версия остаётся твоей."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดเมื่อไรก็ได้: เวอร์ชันของคุณยังเป็นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstediğin zaman bırak: sürümün senin kalır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можеш зупинитися будь-коли: твоя версія залишається твоєю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "随时可以停止：你的版本依然归你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "隨時可以停止：你的版本依然歸你。"
          }
        }
      }
    },
