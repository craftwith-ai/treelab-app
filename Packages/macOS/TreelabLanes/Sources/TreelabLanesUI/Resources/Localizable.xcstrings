    "treelab.privacy.erase.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمحو بيانات Treelab وlab على هذا الـ Mac؛ ويخرج مفتاح OpenAI الخاص بك من سلسلة المفاتيح. خطوتان: لا يُمحى شيء دون تأكيدك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Briše podatke koje Treelab i lab imaju na ovom Macu; tvoj OpenAI ključ napušta privjesak ključeva. Dva koraka: ništa se ne briše bez tvoje potvrde."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter data fra Treelab og lab på denne Mac; din OpenAI-nøgle fjernes fra nøgleringen. To trin: intet slettes uden din bekræftelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Daten von Treelab und lab auf diesem Mac; dein OpenAI-Schlüssel verlässt den Schlüsselbund. Zwei Schritte: Ohne deine Bestätigung geschieht nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases Treelab’s and lab’s data on this Mac; your OpenAI key leaves the keychain. Two steps: nothing goes without your confirmation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los datos de Treelab y de lab en este Mac; tu clave de OpenAI sale del llavero. Dos pasos: nada se borra sin tu confirmación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les données de Treelab et de lab sur ce Mac ; ta clé OpenAI quitte le trousseau. Deux étapes : rien ne part sans ta confirmation."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancella i dati di Treelab e di lab su questo Mac; la tua chiave OpenAI esce dal portachiavi. Due passaggi: non si cancella niente senza la tua conferma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac 上の Treelab と lab のデータを消去し、OpenAI キーをキーチェーンから削除します。2 段階で行い、あなたが確認するまで何も消えません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "លុបទិន្នន័យរបស់ Treelab និង lab នៅលើ Mac នេះ។ សោ OpenAI របស់អ្នកត្រូវដកចេញពី Keychain។ មានពីរជំហាន៖ គ្មានអ្វីត្រូវបានលុបដោយគ្មានការបញ្ជាក់របស់អ្នកទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 있는 Treelab과 lab 데이터를 지우고, OpenAI 키를 키체인에서 제거합니다. 두 단계로 진행합니다: 확인하기 전에는 아무것도 지워지지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sletter dataene til Treelab og lab på denne Macen; OpenAI-nøkkelen din fjernes fra nøkkelringen. To trinn: ingenting slettes uten at du bekrefter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa dane Treelab i lab na tym Macu; twój klucz OpenAI znika z pęku kluczy. Dwa kroki: nic nie zostanie usunięte bez twojego potwierdzenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apaga os dados do Treelab e do lab neste Mac; sua chave da OpenAI é removida das Chaves. Duas etapas: nada é apagado sem a sua confirmação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирает данные Treelab и lab на этом Mac; твой ключ OpenAI удаляется из связки ключей. Два шага: без твоего подтверждения ничего не удаляется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลบข้อมูลของ Treelab และ lab บน Mac เครื่องนี้ และนำคีย์ OpenAI ของคุณออกจากพวงกุญแจ มีสองขั้นตอน: จะไม่มีอะไรถูกลบหากคุณไม่ยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'teki Treelab ve lab verilerini siler; OpenAI anahtarın anahtar zincirinden çıkarılır. İki adım: onayın olmadan hiçbir şey silinmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стирає дані Treelab і lab на цьому Mac; твій ключ OpenAI видаляється з в’язки ключів. Два кроки: без твого підтвердження нічого не видаляється."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除这台 Mac 上 Treelab 和 lab 的数据；你的 OpenAI 密钥会从钥匙串中移除。分两步进行：没有你的确认，什么都不会删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除這台 Mac 上 Treelab 和 lab 的資料；你的 OpenAI 金鑰會從鑰匙圈中移除。分兩步進行：沒有你的確認，什麼都不會刪除。"
          }
        }
      }
    },
