    "treelab.account.seats.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مقعد واحد = Mac واحد. تضيف المقاعد من صفحة الاشتراك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno mjesto = jedan Mac. Mjesta dodaješ sa stranice pretplate."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én plads = én Mac. Du tilføjer pladser fra abonnementssiden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Platz = ein Mac. Weitere Plätze fügst du auf der Abo-Seite hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One seat = one Mac. You add seats from the subscription page."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un puesto = un Mac. Añades puestos desde la página de la suscripción."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poste = un Mac. Tu en ajoutes depuis la page de l’abonnement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una postazione = un Mac. Le aggiungi dalla pagina dell’abbonamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "1 シート = Mac 1 台。シートはサブスクリプションのページで追加します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សិទ្ធិប្រើមួយ = Mac មួយ។ អ្នកបន្ថែមសិទ្ធិប្រើពីទំព័រការជាវ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "시트 1개 = Mac 1대. 구독 페이지에서 시트를 추가합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én plass = én Mac. Du legger til plasser fra abonnementssiden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedno stanowisko = jeden Mac. Stanowiska dodajesz na stronie subskrypcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um assento = um Mac. Você adiciona assentos na página da assinatura."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одно место = один Mac. Места добавляешь на странице подписки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "1 สิทธิ์ = Mac 1 เครื่อง คุณเพิ่มสิทธิ์ได้จากหน้าการสมัครสมาชิก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir koltuk = bir Mac. Koltukları abonelik sayfasından eklersin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одне місце = один Mac. Місця додаєш на сторінці підписки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1 个席位 = 1 台 Mac。在订阅页面添加席位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "1 個席位 = 1 台 Mac。在訂閱頁面新增席位。"
          }
        }
      }
    },
