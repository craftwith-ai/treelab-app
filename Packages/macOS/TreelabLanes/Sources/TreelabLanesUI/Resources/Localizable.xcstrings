    "treelab.privacy.listen.name.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its name is recognized on your Mac alone; nothing goes to OpenAI before."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son nom est reconnu sur ton Mac seul ; rien ne part chez OpenAI avant."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Name wird nur auf deinem Mac erkannt; vorher geht nichts an OpenAI."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nombre se reconoce solo en tu Mac; antes no va nada a OpenAI."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتعرّف على اسمه على Mac الخاص بك وحده؛ ولا يذهب شيء إلى OpenAI قبل ذلك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的名字只在你的 Mac 上识别；在此之前不会向 OpenAI 发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的名字只在你的 Mac 上辨識；在此之前不會向 OpenAI 傳送任何內容。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 내 Mac에서만 인식합니다. 그 전에는 아무것도 OpenAI로 보내지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の認識はあなたの Mac だけで行います。それまでは何も OpenAI に送りません。"
          }
        }
      }
    },
    "treelab.privacy.microphone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone: Ginkgo will ask you for it at your first conversation, to hear you. Treelab never listens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro : Ginkgo te le demandera à ta première conversation, pour t’entendre. Treelab n’écoute jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon: Ginkgo fragt dich beim ersten Gespräch danach, um dich zu hören. Treelab hört nie zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono: Ginkgo te lo pedirá en tu primera conversación, para oírte. Treelab nunca escucha."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون: سيطلبه منك Ginkgo في أول محادثة لك، ليسمعك. لا يستمع Treelab أبدًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风：Ginkgo 会在你第一次对话时请求使用它，以便听到你。Treelab 从不收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風：Ginkgo 會在你第一次對話時請求使用它，以便聽到你。Treelab 從不收聽。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크: Ginkgo가 첫 대화 때 내 목소리를 들으려고 마이크 권한을 요청합니다. Treelab은 절대 듣지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイク：Ginkgo は最初の会話のとき、あなたの声を聞くためにマイクの許可を求めます。Treelab が聞くことはありません。"
          }
        }
      }
    },
