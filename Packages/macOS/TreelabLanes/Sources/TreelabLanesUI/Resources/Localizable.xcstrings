    "treelab.welcome.trial.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why? To keep your trial and your subscription on each of your Macs. No password: a one-time link arrives in your inbox."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi ? Pour garder ton essai et ton abonnement sur chacun de tes Mac. Pas de mot de passe : un lien à usage unique arrive dans ta boîte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum? Damit deine Testphase und dein Abo auf jedem deiner Macs gelten. Kein Passwort: Ein Einmal-Link kommt in dein Postfach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué? Para conservar tu prueba y tu suscripción en cada uno de tus Mac. Sin contraseña: te llega a la bandeja de entrada un enlace de un solo uso."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا؟ لتحتفظ بتجربتك واشتراكك على كل أجهزة Mac لديك. بلا كلمة مرور: يصلك رابط لمرة واحدة في بريدك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么？为了在你的每台 Mac 上保留你的试用和订阅。无需密码：一次性链接会发到你的收件箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼？為了在你的每台 Mac 上保留你的試用和訂閱。無需密碼：一次性連結會寄到你的收件匣。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜 필요할까요? 내 모든 Mac에서 체험과 구독을 유지하기 위해서입니다. 비밀번호는 필요 없습니다: 일회용 링크가 받은편지함으로 옵니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜ？お使いのすべての Mac でトライアルとサブスクリプションを引き継ぐためです。パスワードは不要です。1 回限りのリンクが受信トレイに届きます。"
          }
        }
      }
    },
