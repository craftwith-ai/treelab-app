    "treelab.privacy.erase.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Erases Treelab’s and lab’s data on this Mac; your OpenAI key leaves the keychain. Two steps: nothing goes without your confirmation."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Efface les données de Treelab et de lab sur ce Mac ; ta clé OpenAI quitte le trousseau. Deux étapes : rien ne part sans ta confirmation."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Löscht die Daten von Treelab und lab auf diesem Mac; dein OpenAI-Schlüssel verlässt den Schlüsselbund. Zwei Schritte: Ohne deine Bestätigung geschieht nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra los datos de Treelab y de lab en este Mac; tu clave de OpenAI sale del llavero. Dos pasos: nada se borra sin tu confirmación."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمحو بيانات Treelab وlab على هذا الـ Mac؛ ويخرج مفتاح OpenAI الخاص بك من سلسلة المفاتيح. خطوتان: لا يُمحى شيء دون تأكيدك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "清除这台 Mac 上 Treelab 和 lab 的数据；你的 OpenAI 密钥会从钥匙串中移除。分两步进行：没有你的确认，什么都不会删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "清除這台 Mac 上 Treelab 和 lab 的資料；你的 OpenAI 金鑰會從鑰匙圈中移除。分兩步進行：沒有你的確認，什麼都不會刪除。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 있는 Treelab과 lab 데이터를 지우고, OpenAI 키를 키체인에서 제거합니다. 두 단계로 진행합니다: 확인하기 전에는 아무것도 지워지지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Mac 上の Treelab と lab のデータを消去し、OpenAI キーをキーチェーンから削除します。2 段階で行い、あなたが確認するまで何も消えません。"
          }
        }
      }
    },
