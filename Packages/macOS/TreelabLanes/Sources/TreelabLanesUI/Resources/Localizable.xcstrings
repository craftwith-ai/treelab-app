    "treelab.welcome.word.batch.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوة من مسار، من السؤال إلى التسليم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedna etapa staze, od pitanja do isporuke."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Én etape af et spor, fra spørgsmålet til leveringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Schritt einer Spur, von der Frage bis zur Lieferung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One step of a lane, from the question to the delivery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una etapa de un carril, de la pregunta a la entrega."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une étape d’un couloir, de la question à la livraison."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tappa di una corsia, dalla domanda alla consegna."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンのひとつの段階。質問から引き渡しまで。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដំណាក់កាលមួយនៃផ្លូវការងារ ពីសំណួររហូតដល់ការប្រគល់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로의 한 단계로, 질문부터 결과물 전달까지입니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Én etappe i et spor, fra spørsmålet til leveransen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden etap toru, od pytania do dostarczenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma etapa de uma trilha, da pergunta à entrega."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Один этап дорожки, от вопроса до сдачи."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หนึ่งขั้นของเลน ตั้งแต่คำถามจนถึงการส่งมอบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kulvarın bir adımı, sorudan teslimata."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Один етап доріжки, від питання до здачі."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通道中的一步，从提问到交付。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通道中的一步，從提問到交付。"
          }
        }
      }
    },
    "treelab.welcome.word.feed.detail": {
      "comment": "Feed is a Treelab name, not translated.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كل ما ينتظرك، طلبًا تلو الآخر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve što te čeka, jedan po jedan zahtjev."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt, der venter på dig, én anmodning ad gangen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alles, was auf dich wartet, eine Anfrage nach der anderen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything waiting for you, one request at a time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que te espera, una solicitud cada vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui t’attend, une demande à la fois."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che ti aspetta, una richiesta alla volta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなた待ちのものすべてを、リクエスト 1 件ずつ。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីៗទាំងអស់ដែលរង់ចាំអ្នក ម្តងមួយសំណើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나를 기다리는 모든 것을 요청 하나씩."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Alt som venter på deg, én forespørsel om gangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co na ciebie czeka, jedna prośba naraz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tudo o que espera por você, um pedido por vez."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Всё, что тебя ждёт, по одному запросу за раз."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอย่างที่รอคุณอยู่ ทีละคำขอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seni bekleyen her şey, her seferinde bir istek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Усе, що на тебе чекає, по одному запиту за раз."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有在等你的事项，一次一个请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有在等你的事項，一次一個請求。"
          }
        }
      }
    },
