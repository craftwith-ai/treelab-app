    "treelab.account.trialNoCharge": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يُقتطع أي مبلغ عند انتهاء التجربة. للمتابعة، اختر خطتك:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad proba završi, ništa se ne naplaćuje. Za nastavak izaberi svoj plan:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der trækkes intet, når prøveperioden slutter. Vælg din plan for at fortsætte:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Am Ende der Testphase wird nichts abgebucht. Um weiterzumachen, wähle deinen Tarif:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is charged when the trial ends. To go on, pick your plan:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cobra nada al terminar la prueba. Para seguir, elige tu plan:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est prélevé à la fin de l’essai. Pour continuer, choisis ta formule :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla fine della prova non ti viene addebitato niente. Per continuare, scegli il tuo piano:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トライアル終了時に料金は発生しません。続けるにはプランを選んでください："
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានការគិតប្រាក់ទេ នៅពេលការសាកល្បងចប់។ ដើម្បីបន្ត សូមជ្រើសកញ្ចប់របស់អ្នក៖"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체험이 끝나도 요금이 청구되지 않습니다. 계속하려면 요금제를 고르세요:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting trekkes når prøveperioden slutter. Velg planen din for å fortsette:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po zakończeniu okresu próbnego nic nie zostanie pobrane. Żeby kontynuować, wybierz plan:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é cobrado quando o teste termina. Para continuar, escolha seu plano:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда пробный период закончится, ничего не спишется. Чтобы продолжить, выбери тариф:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อสิ้นสุดช่วงทดลองใช้จะไม่มีการเรียกเก็บเงิน หากต้องการใช้ต่อ เลือกแพ็กเกจของคุณ:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Deneme bittiğinde hiçbir ücret alınmaz. Devam etmek için planını seç:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли пробний період закінчиться, нічого не буде списано. Щоб продовжити, вибери тариф:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试用结束时不会扣费。如需继续，请选择方案："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "試用結束時不會扣款。如需繼續，請選擇方案："
          }
        }
      }
    },
