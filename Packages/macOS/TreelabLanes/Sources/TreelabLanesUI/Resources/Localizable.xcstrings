    "treelab.ginkgo.state.listening.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “yes” to confirm, or “stop”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis « oui » pour confirmer, ou « stop »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „ja“ zum Bestätigen oder „stopp“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di «sí» para confirmar, o «stop»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل «نعم» للتأكيد، أو «توقف»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说“是”确认，或说“停”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說「是」確認，或說「停」。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하려면 “네”, 멈추려면 “그만”이라고 말하세요."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定するには「はい」、やめるには「ストップ」と言ってください。"
          }
        }
      }
    },
