    "treelab.feed.answerPlaceholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أخبر Claude بما يجب تغييره…"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Napiši šta Claude treba promijeniti…"
