    "treelab.welcome.overview.welcome.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات Treelab، وما يغادر جهاز Mac الخاص بك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Riječi koje Treelab koristi, i šta izlazi s tvog Maca."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelabs ord, og hvad der forlader din Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wörter von Treelab und was deinen Mac verlässt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab’s words, and what leaves your Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras de Treelab, y lo que sale de tu Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de Treelab, et ce qui sort de ton Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le parole di Treelab, e cosa esce dal tuo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab の用語と、Mac から出ていくもの。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពាក្យរបស់ Treelab និងអ្វីដែលចេញពី Mac របស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab의 용어, 그리고 Mac 밖으로 나가는 것."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordene i Treelab, og det som forlater Macen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Słowa Treelab i to, co wychodzi z twojego Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As palavras do Treelab, e o que sai do seu Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова Treelab и то, что уходит с твоего Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำศัพท์ของ Treelab และสิ่งที่ส่งออกจาก Mac ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab'ın kelimeleri ve Mac'inden çıkanlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Слова Treelab і те, що йде з твого Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 的用语，以及什么会离开你的 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 的用語，以及什麼會離開你的 Mac。"
          }
        }
      }
    },
    "treelab.welcome.privacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا قياس للاستخدام، ولا تتبّع. لا يخرج عملك إلا إلى Claude، وإلى OpenAI عندما تتحدث إلى Ginkgo."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez mjerenja korištenja, bez praćenja. Tvoj rad ide samo u Claude, i u OpenAI kad razgovaraš s Ginkgom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen måling af brug, ingen sporing. Dit arbejde sendes kun til Claude, og til OpenAI, når du taler med Ginkgo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nutzungsmessung, kein Tracking. Deine Arbeit geht nur an Claude, und an OpenAI, wenn du mit Ginkgo sprichst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usage measurement, no tracking. Your work only leaves for Claude, and for OpenAI when you talk to Ginkgo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin medición de uso, sin rastreo. Tu trabajo solo sale hacia Claude, y hacia OpenAI cuando hablas con Ginkgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mesure de ton usage, aucun pistage. Ton travail ne sort que vers Claude, et vers OpenAI quand tu parles à Ginkgo."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna misura dell’uso, nessun tracciamento. Il tuo lavoro esce solo verso Claude, e verso OpenAI quando parli con Ginkgo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用状況の計測もトラッキングもありません。作業内容が送られるのは Claude だけで、Ginkgo と話すときは OpenAI にも送られます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានការវាស់ការប្រើប្រាស់ គ្មានការតាមដាន។ ការងាររបស់អ្នកចេញទៅតែ Claude ប៉ុណ្ណោះ និងទៅ OpenAI ពេលអ្នកនិយាយជាមួយ Ginkgo។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용량 측정도, 추적도 없습니다. 작업 내용은 Claude로만 나가고, Ginkgo와 대화할 때는 OpenAI로도 나갑니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen måling av bruk, ingen sporing. Arbeidet ditt sendes bare til Claude, og til OpenAI når du snakker med Ginkgo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez pomiaru użycia, bez śledzenia. Twoja praca trafia tylko do Claude, a do OpenAI, gdy rozmawiasz z Ginkgo."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma medição de uso, nenhum rastreamento. Seu trabalho só sai para o Claude, e para a OpenAI quando você fala com o Ginkgo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без замеров использования и без отслеживания. Твоя работа уходит только в Claude, а в OpenAI — когда ты говоришь с Ginkgo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการวัดการใช้งาน ไม่มีการติดตาม งานของคุณจะถูกส่งไปที่ Claude เท่านั้น และไปที่ OpenAI เมื่อคุณคุยกับ Ginkgo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım ölçümü yok, izleme yok. Çalışmaların yalnızca Claude'a, Ginkgo ile konuştuğunda da OpenAI'a gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без вимірювання використання, без стеження. Твоя робота йде лише до Claude, а до OpenAI — коли ти говориш із Ginkgo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不统计使用情况，不跟踪。你的工作只会发给 Claude，以及在你和 Ginkgo 说话时发给 OpenAI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不統計使用情況，不追蹤。你的工作只會傳給 Claude，以及在你和 Ginkgo 說話時傳給 OpenAI。"
          }
        }
      }
    },
