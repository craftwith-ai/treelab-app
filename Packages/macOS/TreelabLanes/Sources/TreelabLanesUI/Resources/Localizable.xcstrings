    "treelab.appearance.hud.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "خطوط مضيئة على خلفية ليلية، وحركة خفيفة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svijetle linije na noćnoj pozadini, lagano kretanje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lysende streger på natbaggrund, let bevægelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Helle Linien auf Nachthintergrund, sanfte Bewegung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bright lines on a night background, light motion."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trazos luminosos sobre fondo nocturno, movimiento suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traits lumineux sur fond nuit, mouvement léger."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Linee luminose su sfondo notte, movimento leggero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "夜の背景に明るいライン、控えめな動き。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ទាត់ភ្លឺលើផ្ទៃពណ៌យប់ ចលនាស្រាល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "어두운 밤 배경 위 밝은 선, 은은한 움직임."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lysende streker på nattbakgrunn, lett bevegelse."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jasne linie na nocnym tle, lekki ruch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Traços luminosos sobre fundo noturno, movimento leve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Светящиеся линии на ночном фоне, лёгкая анимация."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เส้นสว่างบนพื้นหลังสีกลางคืน เคลื่อนไหวเบาๆ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gece arka planında parlak çizgiler, hafif hareket."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Світлі лінії на нічному тлі, легка анімація."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "夜色背景上的明亮线条，轻微动效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "夜色背景上的明亮線條，輕微動態效果。"
          }
        }
      }
    },
