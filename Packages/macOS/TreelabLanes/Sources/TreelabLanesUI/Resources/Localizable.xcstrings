    "treelab.appearance.language.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع Treelab لغة Mac الخاص بك؛ ويمكنك اختيار لغة أخرى لـ Treelab وحده. يجيبك Ginkgo بلغتك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab prati jezik tvog Maca; možeš izabrati drugi samo za Treelab. Ginkgo ti odgovara na tvom."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab følger sproget på din Mac; du kan vælge et andet kun til Treelab. Ginkgo svarer dig på dit."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab folgt der Sprache deines Mac; du kannst eine andere nur für Treelab wählen. Ginkgo antwortet in deiner."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab follows your Mac’s language; you can pick another one for Treelab alone. Ginkgo answers in yours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab sigue el idioma de tu Mac; puedes elegir otro solo para Treelab. Ginkgo te responde en el tuyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab suit la langue de ton Mac ; tu peux en choisir une autre pour Treelab seul. Ginkgo te répond dans la tienne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab segue la lingua del tuo Mac; puoi sceglierne un’altra solo per Treelab. Ginkgo ti risponde nella tua."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab は Mac の言語に従います。Treelab だけ別の言語にすることもできます。Ginkgo はあなたの言語で答えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab ប្រើភាសាតាម Mac របស់អ្នក។ អ្នកអាចជ្រើសភាសាផ្សេងសម្រាប់តែ Treelab។ Ginkgo ឆ្លើយអ្នកជាភាសារបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab은 Mac의 언어를 따릅니다. Treelab에만 다른 언어를 고를 수도 있습니다. Ginkgo는 내 언어로 답합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab følger språket på Macen din; du kan velge et annet bare for Treelab. Ginkgo svarer deg på ditt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab używa języka twojego Maca; możesz wybrać inny tylko dla Treelab. Ginkgo odpowiada ci w twoim."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Treelab segue o idioma do seu Mac; você pode escolher outro só para o Treelab. O Ginkgo responde no seu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab следует языку твоего Mac; можно выбрать другой только для Treelab. Ginkgo отвечает на твоём."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab ใช้ภาษาเดียวกับ Mac ของคุณ คุณเลือกภาษาอื่นให้เฉพาะ Treelab ได้ Ginkgo จะตอบเป็นภาษาของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab, Mac'inin dilini izler; yalnızca Treelab için başka bir dil seçebilirsin. Ginkgo senin dilinde yanıt verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab використовує мову твого Mac; можна вибрати іншу лише для Treelab. Ginkgo відповідає твоєю."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 跟随你 Mac 的语言；你也可以只为 Treelab 选择另一种语言。Ginkgo 会用你的语言回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 跟隨你 Mac 的語言；你也可以只為 Treelab 選擇另一種語言。Ginkgo 會用你的語言回答。"
          }
        }
      }
    },
