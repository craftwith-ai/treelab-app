    "treelab.appearance.motion.reduced": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يقلّل Mac الحركة: يوقف Treelab الرسوم المتحركة، بما في ذلك Ginkgo."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac smanjuje kretanje: Treelab isključuje animacije, uključujući Ginkgo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen reducerer bevægelse: Treelab slår animationer fra, også Ginkgo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac reduziert Bewegung: Treelab schaltet Animationen aus, auch bei Ginkgo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac reduces motion: Treelab turns animations off, Ginkgo included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac reduce el movimiento: Treelab desactiva las animaciones, Ginkgo incluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac réduit les animations : Treelab les coupe, Ginkgo compris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac riduce il movimento: Treelab spegne le animazioni, Ginkgo compreso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac で動きを減らす設定になっています。Treelab は Ginkgo も含めてアニメーションをオフにします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac កាត់បន្ថយចលនា៖ Treelab បិទចលនា រួមទាំង Ginkgo។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac에서 동작 줄이기가 켜져 있습니다: Treelab이 Ginkgo를 포함해 애니메이션을 끕니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen reduserer bevegelse: Treelab slår av animasjoner, også Ginkgo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ogranicza ruch: Treelab wyłącza animacje, Ginkgo też."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac reduz o movimento: o Treelab desliga as animações, inclusive no Ginkgo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На Mac включено уменьшение движения: Treelab отключает анимации, включая Ginkgo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ลดการเคลื่อนไหวอยู่: Treelab จะปิดภาพเคลื่อนไหว รวมถึงของ Ginkgo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac hareketi azaltıyor: Treelab animasyonları kapatır, Ginkgo dahil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На Mac увімкнено зменшення руху: Treelab вимикає анімації, зокрема в Ginkgo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 已减弱动态效果：Treelab 关闭了动画，包括 Ginkgo 的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 已減少動態效果：Treelab 關閉了動畫，包括 Ginkgo 的。"
          }
        }
      }
    },
