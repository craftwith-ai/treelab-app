    "treelab.privacy.safeguards": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing a lane needs your spoken “yes”, within 120 seconds. Without your “yes”, nothing happens. Ginkgo acts only when you ask."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fermer un couloir demande ton « oui » à voix haute, dans les 120 secondes. Sans ton « oui », rien ne se passe. Ginkgo n’agit que sur ta demande."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Spur zu schließen braucht dein gesprochenes „ja“, innerhalb von 120 Sekunden. Ohne dein „ja“ passiert nichts. Ginkgo handelt nur auf deine Bitte."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cerrar un carril necesita tu «sí» en voz alta, en menos de 120 segundos. Sin tu «sí», no pasa nada. Ginkgo solo actúa cuando se lo pides."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب إغلاق مسار أن تقول «نعم» بصوت عالٍ خلال 120 ثانية. من دون «نعم» منك لا يحدث شيء. لا يتصرف Ginkgo إلا بطلبك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭通道需要你在 120 秒内大声说“是”。没有你的“是”，什么都不会发生。Ginkgo 只在你要求时行动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉通道需要你在 120 秒內大聲說「是」。沒有你的「是」，什麼都不會發生。Ginkgo 只在你要求時行動。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로를 닫으려면 120초 안에 소리 내어 “네”라고 말해야 합니다. “네”가 없으면 아무 일도 일어나지 않습니다. Ginkgo는 요청할 때만 움직입니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンを終了するには、120 秒以内に声で「はい」と言う必要があります。「はい」がなければ何も起きません。Ginkgo は頼まれたときだけ動きます。"
          }
        }
      }
    },
    "treelab.privacy.speak.always": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Always"
          }
        },
        "fr": {
