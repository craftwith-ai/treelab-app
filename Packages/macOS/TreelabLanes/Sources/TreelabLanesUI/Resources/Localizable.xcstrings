    "treelab.appearance.language.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab follows your Mac’s language; you can pick another one for Treelab alone. Ginkgo answers in yours."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab suit la langue de ton Mac ; tu peux en choisir une autre pour Treelab seul. Ginkgo te répond dans la tienne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab folgt der Sprache deines Mac; du kannst eine andere nur für Treelab wählen. Ginkgo antwortet in deiner."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab sigue el idioma de tu Mac; puedes elegir otro solo para Treelab. Ginkgo te responde en el tuyo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتبع Treelab لغة Mac الخاص بك؛ ويمكنك اختيار لغة أخرى لـ Treelab وحده. يجيبك Ginkgo بلغتك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 跟随你 Mac 的语言；你也可以只为 Treelab 选择另一种语言。Ginkgo 会用你的语言回答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 跟隨你 Mac 的語言；你也可以只為 Treelab 選擇另一種語言。Ginkgo 會用你的語言回答。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab은 Mac의 언어를 따릅니다. Treelab에만 다른 언어를 고를 수도 있습니다. Ginkgo는 내 언어로 답합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab は Mac の言語に従います。Treelab だけ別の言語にすることもできます。Ginkgo はあなたの言語で答えます。"
          }
        }
      }
    },
    "treelab.appearance.language.open": {
      "comment": "Button.",
      "extractionState": "manual",
      "localizations": {
