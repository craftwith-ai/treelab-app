    "treelab.account.notice.legacy": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبقى ترخيصك الحالي صالحًا: لا شيء للدفع حاليًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoja trenutna licenca i dalje važi: zasad ništa ne plaćaš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din nuværende licens gælder stadig: intet at betale indtil videre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine aktuelle Lizenz bleibt gültig: vorerst nichts zu zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your current licence stays valid: nothing to pay for now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu licencia actual sigue siendo válida: nada que pagar por ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta licence actuelle reste valable : rien à payer pour l’instant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua licenza attuale resta valida: niente da pagare per ora."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在のライセンスは引き続き有効です。今のところ支払いは不要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អាជ្ញាប័ណ្ណបច្ចុប្បន្នរបស់អ្នកនៅតែមានសុពលភាព៖ សម្រាប់ពេលនេះ មិនបាច់បង់អ្វីទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 라이선스는 계속 유효합니다: 지금은 결제할 필요가 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den nåværende lisensen din er fortsatt gyldig: ingenting å betale foreløpig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja obecna licencja jest nadal ważna: na razie nic do zapłaty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua licença atual continua válida: nada a pagar por enquanto."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя текущая лицензия остаётся в силе: пока платить не нужно."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไลเซนส์ปัจจุบันของคุณยังใช้ได้: ตอนนี้ยังไม่ต้องจ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mevcut lisansın geçerli kalıyor: şimdilik ödeme yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твоя поточна ліцензія лишається чинною: поки нічого платити не треба."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现有的许可证仍然有效：暂时无需付费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你現有的授權仍然有效：暫時無需付費。"
          }
        }
      }
    },
    "treelab.account.notice.linkSent": {
      "comment": "%@ is the e-mail address.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسل الرابط إلى %@. افتحه على هذا الـ Mac لتسجيل الدخول."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Link je poslan na %@. Otvori ga na ovom Macu da se prijaviš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Link sendt til %@. Åbn det på denne Mac for at logge ind."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Link an %@ gesendet. Öffne ihn auf diesem Mac, um dich anzumelden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Link sent to %@. Open it on this Mac to sign in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enlace enviado a %@. Ábrelo en este Mac para iniciar sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lien envoyé à %@. Ouvre-le sur ce Mac pour te connecter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Link inviato a %@. Aprilo su questo Mac per accedere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ にリンクを送信しました。この Mac で開いてサインインしてください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានផ្ញើតំណទៅ %@។ បើកវានៅលើ Mac នេះដើម្បីចូល។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 주소로 링크를 보냈습니다. 이 Mac에서 열어 로그인하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lenke sendt til %@. Åpne den på denne Macen for å logge på."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Link wysłany na %@. Otwórz go na tym Macu, żeby się zalogować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Link enviado para %@. Abra-o neste Mac para fazer login."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ссылка отправлена на %@. Открой её на этом Mac, чтобы войти."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งลิงก์ไปที่ %@ แล้ว เปิดลิงก์บน Mac เครื่องนี้เพื่อลงชื่อเข้าใช้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bağlantı %@ adresine gönderildi. Oturum açmak için onu bu Mac'te aç."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Посилання надіслано на %@. Відкрий його на цьому Mac, щоб увійти."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链接已发送到 %@。在这台 Mac 上打开它即可登录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "連結已傳送到 %@。在這台 Mac 上開啟它即可登入。"
          }
        }
      }
    },
