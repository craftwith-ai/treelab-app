    "treelab.appearance.black.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أبسط وأشد سوادًا. يأتي في إصدار قادم."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jednostavnija, tamnija. Stiže u budućoj verziji."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mere enkel, mørkere. Kommer i en fremtidig version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlichter, dunkler. Kommt in einer künftigen Version."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Plainer, darker. It comes in a future version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Más sobrio, más oscuro. Llega en una versión futura."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus sobre, plus noir. Il arrive dans une prochaine version."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Più sobrio, più scuro. Arriva in una prossima versione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "よりシンプルで、より暗いテーマ。今後のバージョンで登場します。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សាមញ្ញជាង ងងឹតជាង។ វានឹងមកក្នុងកំណែនាពេលខាងមុខ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "더 단순하고 더 어둡습니다. 이후 버전에서 제공됩니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Enklere, mørkere. Kommer i en fremtidig versjon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prostszy, ciemniejszy. Pojawi się w przyszłej wersji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mais sóbrio, mais escuro. Chega em uma próxima versão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Строже и темнее. Появится в одной из следующих версий."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เรียบกว่า มืดกว่า จะมาในเวอร์ชันถัดๆ ไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha sade, daha koyu. Gelecek bir sürümde geliyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стриманіша, темніша. З’явиться в одній із наступних версій."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更朴素，更暗。将在未来版本中推出。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "更樸素，更暗。將在未來版本中推出。"
          }
        }
      }
    },
