    "treelab.ginkgo.state.listening.confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل «نعم» للتأكيد، أو «توقف»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Reci „da“ za potvrdu, ili „stop“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig »ja« for at bekræfte, eller »stop«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag „ja“ zum Bestätigen oder „stopp“."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “yes” to confirm, or “stop”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di «sí» para confirmar, o «stop»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis « oui » pour confirmer, ou « stop »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di’ “sì” per confermare, o “stop”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確定するには「はい」、やめるには「ストップ」と言ってください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "និយាយ «បាទ/ចាស» ដើម្បីបញ្ជាក់ ឬ «ឈប់»។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하려면 “네”, 멈추려면 “그만”이라고 말하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si «ja» for å bekrefte, eller «stopp»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz „tak”, żeby potwierdzić, albo „stop”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga “sim” para confirmar, ou “pare”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи «да», чтобы подтвердить, или «стоп»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดว่า “ใช่” เพื่อยืนยัน หรือ “หยุด”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamak için “evet” de ya da “dur”."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи «так», щоб підтвердити, або «стоп»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说“是”确认，或说“停”。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說「是」確認，或說「停」。"
          }
        }
      }
    },
    "treelab.ginkgo.state.listening.detail": {
      "extractionState": "manual",
      "localizations": {
