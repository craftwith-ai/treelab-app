          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac verweigert Ginkgo das Mikrofon: Erlaube es in Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac niega el micrófono a Ginkgo: permítelo en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
