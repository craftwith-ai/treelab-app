          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ไม่ได้ทำงาน: กด “พูด” เพื่อเริ่ม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo çalışmıyor: “Konuş” onu başlatır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo не запущено: «Говорити» запускає його."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 未运行：点“说话”即可启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 未執行：點「說話」即可啟動。"
          }
        }
      }
    },
