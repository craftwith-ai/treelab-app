        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ช่วงเวลาเงียบต้องมีเวลาเริ่มและเวลาสิ้นสุดต่างกัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessiz saatlerin başlangıcı ve bitişi farklı olmalı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихі години: початок і кінець мають відрізнятися."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
