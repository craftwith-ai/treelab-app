            "state": "translated",
            "value": "Beendet alle Sitzungen deines Kontos, auch auf diesem Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cierra todas las sesiones de tu cuenta, incluido este Mac."
          }
        },
