    "treelab.privacy.quiet.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء بصوت عالٍ خلال هذه الساعات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "U tim satima ništa naglas."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet højt i disse timer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In diesen Stunden nichts laut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing out loud during these hours."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en voz alta durante estas horas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien à voix haute pendant ces heures."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente ad alta voce in queste ore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この時間帯は声に出しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីនិយាយឮៗក្នុងម៉ោងទាំងនេះទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 시간에는 소리 내어 말하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting høyt i disse timene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tych godzinach nic na głos."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada em voz alta nesse horário."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В эти часы — ничего вслух."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีเสียงพูดออกมาในช่วงเวลานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu saatlerde sesli hiçbir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У ці години — нічого вголос."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些时段内不出声。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這些時段內不出聲。"
          }
        }
      }
    },
