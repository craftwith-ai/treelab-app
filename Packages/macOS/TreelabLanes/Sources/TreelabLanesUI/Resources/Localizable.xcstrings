          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo braucht ein Update, um mit Treelab zu arbeiten: Aktualisiere treelab und versuche es erneut. Nichts wurde gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo necesita una actualización para funcionar con Treelab: actualiza treelab y vuelve a intentarlo. No se inició nada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Ginkgo إلى تحديث ليعمل مع Treelab: حدّث treelab ثم أعد المحاولة. لم يُشغَّل شيء."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
