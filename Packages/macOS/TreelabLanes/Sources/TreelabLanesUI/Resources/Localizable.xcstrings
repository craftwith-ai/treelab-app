    "treelab.welcome.trial.nextVersion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in comes with the next version of treelab. You can already subscribe from the settings."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion arrive avec la prochaine version de treelab. Tu peux déjà t’abonner depuis les réglages."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung kommt mit der nächsten Version von treelab. Abonnieren kannst du schon in den Einstellungen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión llega con la próxima versión de treelab. Ya puedes suscribirte desde los ajustes."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي تسجيل الدخول مع الإصدار القادم من treelab. يمكنك الاشتراك من الآن عبر الإعدادات."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录功能将随下一版 treelab 推出。你现在已经可以在设置中订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入功能將隨下一版 treelab 推出。你現在已經可以在設定中訂閱。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인은 다음 버전의 treelab에서 제공됩니다. 구독은 지금도 설정에서 할 수 있습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
