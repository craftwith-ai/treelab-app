    "treelab.welcome.trial.then": {
      "comment": "Prices from lab's offer.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then, if you go on: %@ a month or %@ a year, per seat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, si tu continues : %@ par mois ou %@ par an, par poste."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach, wenn du weitermachst: %@ im Monat oder %@ im Jahr, pro Platz."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, si sigues: %@ al mes o %@ al año, por puesto."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعدها، إن تابعت: %@ شهريًا أو %@ سنويًا، لكل مقعد."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后如果继续：每个席位每月 %@ 或每年 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後如果繼續：每個席位每月 %@ 或每年 %@。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
