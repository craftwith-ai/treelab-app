    "treelab.privacy.speak.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a lane starts waiting for you, Ginkgo says so out loud:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un couloir se met à t’attendre, Ginkgo te l’annonce à voix haute :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Spur auf dich zu warten beginnt, sagt Ginkgo es laut:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un carril empieza a esperarte, Ginkgo te lo dice en voz alta:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يبدأ مسار في انتظارك، يعلن Ginkgo ذلك بصوت عالٍ:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当某个通道开始等你时，Ginkgo 会大声说出来："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當某個通道開始等你時，Ginkgo 會大聲說出來："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로가 나를 기다리기 시작하면 Ginkgo가 소리 내어 알려 줍니다:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンがあなた待ちになると、Ginkgo が声に出して知らせます："
          }
        }
      }
    },
