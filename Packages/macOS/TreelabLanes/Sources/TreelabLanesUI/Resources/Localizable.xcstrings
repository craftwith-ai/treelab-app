    "treelab.privacy.nobody.what": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا قياس للاستخدام، ولا تتبّع، ولا إرسال لتقارير الأخطاء"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez mjerenja korištenja, bez praćenja, bez slanja izvještaja o greškama"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen måling af brug, ingen sporing, ingen fejlrapporter sendt"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nutzungsmessung, kein Tracking, kein Fehlerbericht wird gesendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usage measurement, no tracking, no error report sent"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin medición de uso, sin rastreo, sin informes de errores enviados"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mesure de ton usage, aucun pistage, aucun rapport d’erreur envoyé"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna misura dell’uso, nessun tracciamento, nessun rapporto d’errore inviato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用状況の計測なし、トラッキングなし、エラーレポートの送信なし"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានការវាស់ការប្រើប្រាស់ គ្មានការតាមដាន គ្មានការផ្ញើរបាយការណ៍កំហុស"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용량 측정 없음, 추적 없음, 오류 보고서 전송 없음"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen måling av bruk, ingen sporing, ingen feilrapporter sendt"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez pomiaru użycia, bez śledzenia, bez wysyłania raportów o błędach"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma medição de uso, nenhum rastreamento, nenhum relatório de erro enviado"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без замеров использования, без отслеживания, без отправки отчётов об ошибках"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีการวัดการใช้งาน ไม่มีการติดตาม ไม่มีการส่งรายงานข้อผิดพลาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kullanım ölçümü yok, izleme yok, hata raporu gönderilmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без вимірювання використання, без стеження, без надсилання звітів про помилки"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不统计使用情况，不跟踪，不发送错误报告"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不統計使用情況，不追蹤，不傳送錯誤報告"
          }
        }
      }
    },
