    "treelab.welcome.overview.account.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تجربة مجانية، دون بطاقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Besplatna proba, bez kartice."
          }
        },
        "da": {
          "stringUnit": {
