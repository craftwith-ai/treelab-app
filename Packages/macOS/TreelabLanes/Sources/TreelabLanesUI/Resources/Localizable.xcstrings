      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "what you say is written, then Ginkgo’s answer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ce que tu dis s’écrit, puis ce que Ginkgo répond"
