    "treelab.ginkgo.confirm.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل «نعم» خلال دقيقتين؛ من دون «نعم» منك لا يحدث شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Reci „da“ u roku od 2 minute; bez tvog „da“ ništa se ne dešava."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sig »ja« inden for 2 minutter; uden dit »ja« sker der intet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag innerhalb von 2 Minuten „ja“; ohne dein „ja“ passiert nichts."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “yes” within 2 minutes; without your “yes”, nothing happens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di «sí» en 2 minutos; sin tu «sí», no pasa nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis « oui » dans les 2 minutes ; sans ton « oui », rien ne se passe."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Di’ “sì” entro 2 minuti; senza il tuo “sì”, non succede niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分以内に「はい」と言ってください。「はい」がなければ何も起きません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "និយាយ «បាទ/ចាស» ក្នុងរយៈពេល 2 នាទី។ បើគ្មាន «បាទ/ចាស» ពីអ្នក គ្មានអ្វីកើតឡើងទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2분 안에 “네”라고 말하세요. “네”가 없으면 아무 일도 일어나지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Si «ja» innen 2 minutter; uten ditt «ja» skjer ingenting."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiedz „tak” w ciągu 2 minut; bez twojego „tak” nic się nie stanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Diga “sim” em até 2 minutos; sem o seu “sim”, nada acontece."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи «да» в течение 2 минут; без твоего «да» ничего не произойдёт."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พูดว่า “ใช่” ภายใน 2 นาที ถ้าไม่พูด “ใช่” จะไม่มีอะไรเกิดขึ้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2 dakika içinde “evet” de; “evet” demezsen hiçbir şey olmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скажи «так» протягом 2 хвилин; без твого «так» нічого не станеться."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 2 分钟内说“是”；没有你的“是”，什么都不会发生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 2 分鐘內說「是」；沒有你的「是」，什麼都不會發生。"
          }
        }
      }
    },
