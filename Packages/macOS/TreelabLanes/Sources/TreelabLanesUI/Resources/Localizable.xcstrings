    "treelab.welcome.word.tower.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحارس الذي يسلّم مساراتك ويعيد تشغيلها."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Čuvar koji isporučuje i ponovo pokreće tvoje staze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vagten, der leverer og genstarter dine spor."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wächter, der deine Spuren ausliefert und neu startet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watcher that delivers and restarts your lanes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vigilante que entrega y reinicia tus carriles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le veilleur qui livre et relance tes couloirs."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il guardiano che consegna e riavvia le tue corsie."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンを見守り、引き渡しと再開を行う見張り役。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកឃ្លាំមើលដែលប្រគល់ និងចាប់ផ្តើមផ្លូវការងាររបស់អ្នកឡើងវិញ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로를 지켜보며 전달하고 다시 시작하는 파수꾼."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vakten som leverer og starter sporene dine på nytt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Strażnik, który dostarcza i ponownie uruchamia twoje tory."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A sentinela que entrega e reinicia suas trilhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Смотритель, который сдаёт и перезапускает твои дорожки."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผู้เฝ้าดูที่ส่งมอบงานและเริ่มเลนของคุณใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kulvarlarını teslim eden ve yeniden başlatan gözcü."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Наглядач, який здає і перезапускає твої доріжки."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替你交付并重新启动通道的守望者。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替你交付並重新啟動通道的守望者。"
          }
        }
      }
    },
