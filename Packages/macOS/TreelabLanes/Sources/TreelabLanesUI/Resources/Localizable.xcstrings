    "treelab.welcome.notifications.denied": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رُفضت الإشعارات: يمكنك السماح بها في إعدادات النظام › الإشعارات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obavještenja odbijena: možeš ih dozvoliti u Postavkama sistema › Obavještenja."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifikationer afvist: du kan tillade dem i Systemindstillinger › Notifikationer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Benachrichtigungen abgelehnt: Du kannst sie in Systemeinstellungen › Mitteilungen erlauben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications declined: you can allow them in System Settings › Notifications."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificaciones rechazadas: puedes permitirlas en Ajustes del Sistema › Notificaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifications refusées : tu peux les autoriser dans Réglages Système › Notifications."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Notifiche rifiutate: puoi consentirle in Impostazioni di Sistema › Notifiche."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通知が拒否されました。システム設定 › 通知 で許可できます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បានបដិសេធការជូនដំណឹង៖ អ្នកអាចអនុញ្ញាតវានៅក្នុង System Settings › Notifications។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림이 거부되었습니다: 시스템 설정 › 알림에서 허용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Varslinger avslått: du kan tillate dem i Systeminnstillinger › Varslinger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiadomienia odrzucone: możesz na nie zezwolić w Ustawieniach systemowych › Powiadomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Notificações recusadas: você pode permiti-las em Ajustes do Sistema › Notificações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Уведомления отклонены: их можно разрешить в Системные настройки › Уведомления."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปฏิเสธการแจ้งเตือนแล้ว: คุณอนุญาตได้ที่ การตั้งค่าระบบ › การแจ้งเตือน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bildirimler reddedildi: Sistem Ayarları › Bildirimler bölümünden izin verebilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення відхилено: їх можна дозволити в Системні параметри › Сповіщення."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已被拒绝：你可以在“系统设置 › 通知”中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "通知已被拒絕：你可以在「系統設定 › 通知」中允許。"
          }
        }
      }
    },
    "treelab.welcome.notifications.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف عندما ينتظر مسار"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Saznaj kad staza čeka"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få besked, når et spor venter"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahre, wenn eine Spur wartet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay told when a lane waits"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entérate cuando un carril espera"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Être prévenu quand un couloir attend"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fatti avvisare quando una corsia aspetta"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンが待っているときに通知を受け取る"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ទទួលដំណឹងពេលផ្លូវការងាររង់ចាំ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로가 기다릴 때 알림 받기"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Få beskjed når et spor venter"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedz, kiedy tor czeka"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receber aviso quando uma trilha espera"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Узнавать, когда дорожка ждёт"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับแจ้งเมื่อเลนรออยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kulvar beklediğinde haberin olsun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Знати, коли доріжка чекає"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有通道在等你时收到通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有通道在等你時收到通知"
          }
        }
      }
    },
    "treelab.welcome.notifications.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا؟ لتعرف أن مسارًا ينتظرك، حتى عندما يكون Treelab خلف نافذة أخرى. فقط عندما نحتاج إليك؛ ولا إعلانات أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zašto? Da znaš da te staza čeka, čak i kad je Treelab iza drugog prozora. Samo kad te staza treba; nikad reklame."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor? For at vide, at et spor venter på dig, også når Treelab ligger bag et andet vindue. Kun når der er brug for dig; aldrig reklamer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum? Damit du weißt, dass eine Spur auf dich wartet, auch wenn Treelab hinter einem anderen Fenster liegt. Nur wenn du gebraucht wirst; nie Werbung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why? To know a lane is waiting for you, even when Treelab is behind another window. Only when you’re needed; never ads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué? Para saber que un carril te espera, incluso cuando Treelab está detrás de otra ventana. Solo cuando se te necesita; nunca publicidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi ? Pour savoir qu’un couloir t’attend, même quand Treelab est derrière une autre fenêtre. Seulement quand on a besoin de toi ; jamais de publicité."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché? Per sapere che una corsia ti aspetta, anche quando Treelab è dietro un’altra finestra. Solo quando servi tu; mai pubblicità."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜ？Treelab がほかのウインドウの後ろにあっても、レーンがあなた待ちだとわかります。必要なときだけで、広告は一切ありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ហេតុអ្វី? ដើម្បីដឹងថាផ្លូវការងារមួយកំពុងរង់ចាំអ្នក ទោះ Treelab នៅពីក្រោយបង្អួចផ្សេងក៏ដោយ។ តែពេលត្រូវការអ្នកប៉ុណ្ណោះ គ្មានការផ្សាយពាណិជ្ជកម្មទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜 필요할까요? Treelab이 다른 창 뒤에 있어도 통로가 나를 기다린다는 것을 알 수 있습니다. 내가 필요할 때만 알리며, 광고는 절대 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor? For å vite at et spor venter på deg, selv når Treelab ligger bak et annet vindu. Bare når du trengs; aldri reklame."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po co? Żeby wiedzieć, że tor na ciebie czeka, nawet gdy Treelab jest za innym oknem. Tylko gdy cię potrzeba; nigdy reklamy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quê? Para saber que uma trilha está esperando por você, mesmo quando o Treelab está atrás de outra janela. Só quando precisam de você; nunca anúncios."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачем? Чтобы знать, что дорожка ждёт тебя, даже когда Treelab за другим окном. Только когда без тебя не обойтись; никакой рекламы."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไม? เพื่อให้รู้ว่ามีเลนรอคุณอยู่ แม้ Treelab จะอยู่หลังหน้าต่างอื่น แจ้งเฉพาะเมื่อต้องการคุณเท่านั้น ไม่มีโฆษณา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden? Treelab başka bir pencerenin arkasındayken bile bir kulvarın seni beklediğini bilmek için. Yalnızca sana ihtiyaç olduğunda; asla reklam yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіщо? Щоб знати, що доріжка чекає на тебе, навіть коли Treelab за іншим вікном. Лише коли без тебе не обійтися; жодної реклами."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么？即使 Treelab 在其他窗口后面，你也能知道有通道在等你。只在需要你时通知；绝无广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼？即使 Treelab 在其他視窗後面，你也能知道有通道在等你。只在需要你時通知；絕無廣告。"
          }
        }
      }
    },
