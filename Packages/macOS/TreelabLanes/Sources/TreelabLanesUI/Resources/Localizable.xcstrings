    "treelab.ginkgo.conversation.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "what you say is written, then Ginkgo’s answer"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ce que tu dis s’écrit, puis ce que Ginkgo répond"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "was du sagst, wird geschrieben, dann Ginkgos Antwort"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "lo que dices se escribe, luego la respuesta de Ginkgo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكتب ما تقوله، ثم ما يجيب به Ginkgo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说的话会写下来，然后是 Ginkgo 的回答"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你說的話會寫下來，然後是 Ginkgo 的回答"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 내용이 적히고, 이어서 Ginkgo의 답이 적힙니다"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容が書かれ、続いて Ginkgo の答えが書かれます"
          }
        }
      }
    },
    "treelab.ginkgo.conversation.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click “Talk” or Ginkgo in the sidebar: the microphone opens, and closes when you say “stop”."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique sur « Parler » ou sur Ginkgo dans la barre : le micro s’ouvre, et se ferme quand tu dis « stop »."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Sprechen“ oder auf Ginkgo in der Seitenleiste: Das Mikrofon geht an und wieder aus, wenn du „stopp“ sagst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «Hablar» o en Ginkgo en la barra lateral: el micrófono se abre y se cierra cuando dices «stop»."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر «تكلّم» أو Ginkgo في الشريط الجانبي: يُفتح الميكروفون، ويُغلق عندما تقول «توقف»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“说话”或侧栏中的 Ginkgo：麦克风打开，说“停”时关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊「說話」或側欄中的 Ginkgo：麥克風開啟，說「停」時關閉。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“말하기” 또는 사이드바의 Ginkgo를 클릭하세요. 마이크가 켜지고, “그만”이라고 하면 꺼집니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「話す」またはサイドバーの Ginkgo をクリックすると、マイクがオンになり、「ストップ」と言うとオフになります。"
          }
        }
      }
    },
