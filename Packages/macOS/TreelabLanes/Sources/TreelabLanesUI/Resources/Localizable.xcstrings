    "treelab.privacy.listen.key.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo listens while you hold the key, not a second longer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo écoute tant que tu tiens la touche, pas une seconde de plus."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo hört zu, solange du die Taste gedrückt hältst, keine Sekunde länger."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo escucha mientras mantienes pulsada la tecla, ni un segundo más."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع Ginkgo ما دمت تضغط المفتاح، ولا ثانية أكثر."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你按住按键时 Ginkgo 才会听，多一秒都不会。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你按住按鍵時 Ginkgo 才會聽，多一秒都不會。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo는 키를 누르고 있는 동안만 듣고, 1초도 더 듣지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo はキーを押している間だけ聞き、1 秒たりとも長くは聞きません。"
          }
        }
      }
    },
    "treelab.privacy.listen.name": {
      "comment": "Listening mode.",
      "extractionState": "manual",
      "localizations": {
        "en": {
