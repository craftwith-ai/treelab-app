    "treelab.ginkgo.state.closed.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يُسمع، ولا شيء يُرسل."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ništa se ne čuje, ništa ne odlazi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Intet høres, intet sendes."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird gehört, nichts verlässt den Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is heard, nothing leaves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se escucha nada, no sale nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est écouté, rien ne part."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si sente niente, non esce niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も聞かず、何も送りません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីត្រូវបានឮ គ្មានអ្វីចេញទៅទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 듣지 않고, 아무것도 나가지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingenting høres, ingenting sendes."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie słychać, nic nie wychodzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada é ouvido, nada sai."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ничего не слышно, ничего не уходит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ยินอะไร ไม่มีอะไรถูกส่งออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey duyulmaz, hiçbir şey gitmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Нічого не чути, нічого не йде назовні."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么都不听，什么都不发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼都不聽，什麼都不傳送。"
          }
        }
      }
    },
