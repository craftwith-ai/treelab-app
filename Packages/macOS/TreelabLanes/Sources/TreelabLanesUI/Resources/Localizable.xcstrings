    "treelab.ginkgo.outcome.expired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No “yes” in time: nothing is closed."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de « oui » à temps : rien n’est fermé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein „ja“ rechtzeitig: nichts wird geschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún «sí» a tiempo: no se cierra nada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تأتِ «نعم» في الوقت: لم يُغلق شيء."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有及时说“是”：什么都没关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有及時說「是」：什麼都沒關閉。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제때 “네”가 없었습니다: 아무것도 닫지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "時間内に「はい」がありませんでした。何も終了しません。"
          }
        }
      }
    },
    "treelab.ginkgo.presence.absent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo is not running: “Talk” starts it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ne tourne pas : « Parler » le démarre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo läuft nicht: „Sprechen“ startet es."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo no está en marcha: «Hablar» lo inicia."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo لا يعمل: «تكلّم» يشغّله."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 未运行：点“说话”即可启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 未執行：點「說話」即可啟動。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo가 실행 중이 아닙니다: “말하기”로 시작합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo は起動していません。「話す」で起動します。"
          }
        }
      }
    },
    "treelab.ginkgo.presence.key": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo needs your OpenAI key: type lab ginkgo key openai in a terminal. Nothing was started."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo a besoin de ta clé OpenAI : tape lab ginkgo key openai dans un terminal. Rien n’a été lancé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo braucht deinen OpenAI-Schlüssel: Tippe lab ginkgo key openai in einem Terminal. Nichts wurde gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo necesita tu clave de OpenAI: escribe lab ginkgo key openai en un terminal. No se inició nada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Ginkgo إلى مفتاح OpenAI الخاص بك: اكتب lab ginkgo key openai في الطرفية. لم يُشغَّل شيء."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 需要你的 OpenAI 密钥：在终端中输入 lab ginkgo key openai。没有启动任何东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 需要你的 OpenAI 金鑰：在終端機中輸入 lab ginkgo key openai。沒有啟動任何東西。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo에 OpenAI 키가 필요합니다: 터미널에서 lab ginkgo key openai를 입력하세요. 아무것도 시작하지 않았습니다."
