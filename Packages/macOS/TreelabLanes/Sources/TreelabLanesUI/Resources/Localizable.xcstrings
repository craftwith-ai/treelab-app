    "treelab.ginkgo.help": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape or “stop” closes the microphone, so does a silence; a second Escape takes you back to the lanes. Ginkgo uses your OpenAI key, kept in the Mac’s keychain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échap ou « stop » ferme le micro, un silence aussi ; un second Échap ramène aux couloirs. Ginkgo utilise ta clé OpenAI, rangée dans le trousseau du Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape oder „stopp“ schaltet das Mikrofon aus, eine Stille auch; ein zweites Escape bringt dich zu den Spuren zurück. Ginkgo nutzt deinen OpenAI-Schlüssel aus dem Schlüsselbund des Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape o «stop» cierra el micrófono, un silencio también; un segundo Escape te devuelve a los carriles. Ginkgo usa tu clave de OpenAI, guardada en el llavero del Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق Escape أو «توقف» الميكروفون، وكذلك الصمت؛ ويعيدك Escape ثانٍ إلى المسارات. يستخدم Ginkgo مفتاح OpenAI الخاص بك، المحفوظ في سلسلة مفاتيح Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Esc 或说“停”会关闭麦克风，沉默也会；再按一次 Esc 返回通道。Ginkgo 使用你存放在 Mac 钥匙串中的 OpenAI 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Esc 或說「停」會關閉麥克風，沉默也會；再按一次 Esc 返回通道。Ginkgo 使用你存放在 Mac 鑰匙圈中的 OpenAI 金鑰。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc 또는 “그만”으로 마이크가 꺼지고, 침묵해도 꺼집니다. Esc를 한 번 더 누르면 통로로 돌아갑니다. Ginkgo는 Mac 키체인에 보관된 OpenAI 키를 사용합니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc か「ストップ」でマイクがオフになり、沈黙でもオフになります。もう一度 Esc で通路に戻ります。Ginkgo は Mac のキーチェーンにある OpenAI キーを使います。"
          }
        }
      }
    },
