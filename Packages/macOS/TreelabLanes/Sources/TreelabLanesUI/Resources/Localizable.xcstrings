        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ម៉ោងស្ងាត់ត្រូវចាប់ពីម៉ោងមួយ ទៅម៉ោងមួយផ្សេងទៀត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "조용한 시간의 시작과 끝은 서로 달라야 합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stilletimer går fra ett klokkeslett til et annet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Początek i koniec godzin ciszy muszą się różnić."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Horas de silêncio: o início e o fim devem ser diferentes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Тихие часы: начало и конец должны отличаться."
          }
