    "treelab.welcome.leaves": {
      "comment": "Link to the privacy settings.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ما يغادر جهاز Mac الخاص بك، وإلى من ›"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Šta izlazi s tvog Maca, i kome ›"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvad der forlader din Mac, og til hvem ›"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Was deinen Mac verlässt, und an wen ›"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What leaves your Mac, and to whom ›"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo que sale de tu Mac, y hacia quién ›"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce qui sort de ton Mac, et vers qui ›"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cosa esce dal tuo Mac, e a chi ›"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac から出ていくものと、その送り先 ›"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីដែលចេញពី Mac របស់អ្នក និងទៅកាន់នរណា ›"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 밖으로 나가는 것과 받는 곳 ›"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Det som forlater Macen din, og til hvem ›"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Co wychodzi z twojego Maca i do kogo ›"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O que sai do seu Mac, e para quem ›"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Что уходит с твоего Mac и кому ›"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่ส่งออกจาก Mac ของคุณ และส่งไปให้ใคร ›"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac'inden ne çıkar, kime gider ›"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Що йде з твого Mac і кому ›"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么会离开你的 Mac，又发给谁 ›"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼會離開你的 Mac，又傳給誰 ›"
          }
        }
      }
    },
