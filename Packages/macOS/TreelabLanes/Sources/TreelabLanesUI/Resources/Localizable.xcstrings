    "treelab.ginkgo.presence.update": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Ginkgo إلى تحديث ليعمل مع Treelab: حدّث treelab ثم أعد المحاولة. لم يُشغَّل شيء."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo treba ažuriranje da bi radio uz Treelab: ažuriraj treelab, pa pokušaj ponovo. Ništa nije pokrenuto."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo skal opdateres for at virke med Treelab: opdater treelab, og prøv igen. Intet blev startet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo braucht ein Update, um mit Treelab zu arbeiten: Aktualisiere treelab und versuche es erneut. Nichts wurde gestartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo needs an update to work with Treelab: update treelab, then try again. Nothing was started."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo necesita una actualización para funcionar con Treelab: actualiza treelab y vuelve a intentarlo. No se inició nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo a besoin d’une mise à jour pour marcher avec Treelab : mets à jour treelab, puis réessaie. Rien n’a été lancé."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ha bisogno di un aggiornamento per funzionare con Treelab: aggiorna treelab, poi riprova. Non è stato avviato niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab と連携するには Ginkgo の更新が必要です。treelab を更新してから再試行してください。何も起動していません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ត្រូវធ្វើបច្ចុប្បន្នភាព ដើម្បីដំណើរការជាមួយ Treelab៖ ធ្វើបច្ចុប្បន្នភាព treelab រួចសាកម្តងទៀត។ គ្មានអ្វីត្រូវបានចាប់ផ្តើមទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo가 Treelab과 작동하려면 업데이트가 필요합니다: treelab을 업데이트한 뒤 다시 시도하세요. 아무것도 시작하지 않았습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo må oppdateres for å virke med Treelab: oppdater treelab, og prøv igjen. Ingenting ble startet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo wymaga aktualizacji, żeby działać z Treelab: zaktualizuj treelab i spróbuj ponownie. Nic nie uruchomiono."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ginkgo precisa de uma atualização para funcionar com o Treelab: atualize o treelab e tente de novo. Nada foi iniciado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo нужно обновить, чтобы он работал с Treelab: обнови treelab и попробуй снова. Ничего не запущено."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ต้องอัปเดตเพื่อใช้กับ Treelab: อัปเดต treelab แล้วลองอีกครั้ง ยังไม่มีอะไรเริ่มทำงาน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo'nun Treelab ile çalışması için güncellenmesi gerekiyor: treelab'ı güncelle, sonra yeniden dene. Hiçbir şey başlatılmadı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo потрібне оновлення, щоб працювати з Treelab: онови treelab і спробуй ще раз. Нічого не запущено."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 需要更新才能配合 Treelab：请更新 treelab 后重试。没有启动任何东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 需要更新才能配合 Treelab：請更新 treelab 後重試。沒有啟動任何東西。"
          }
        }
      }
    },
