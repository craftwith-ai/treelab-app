    "treelab.privacy.openai.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice, and what Ginkgo reads of your lanes to answer you"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta voix, et ce que Ginkgo lit de tes couloirs pour te répondre"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme und was Ginkgo aus deinen Spuren liest, um dir zu antworten"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz, y lo que Ginkgo lee de tus carriles para responderte"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوتك، وما يقرؤه Ginkgo من مساراتك ليجيبك"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的声音，以及 Ginkgo 为回答你而读取的通道内容"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的聲音，以及 Ginkgo 為回答你而讀取的通道內容"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목소리, 그리고 Ginkgo가 답하려고 읽는 통로 내용"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたの声と、Ginkgo が答えるために読むレーンの内容"
          }
        }
      }
    },
