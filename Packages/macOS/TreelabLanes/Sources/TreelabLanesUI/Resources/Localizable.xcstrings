    "treelab.account.signOutEverywhere.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closes every session of your account, this Mac included."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ferme toutes les sessions de ton compte, ce Mac compris."
          }
        },
        "de": {
