    "treelab.ginkgo.state.closed.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is heard, nothing leaves."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est écouté, rien ne part."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nichts wird gehört, nichts verlässt den Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se escucha nada, no sale nada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يُسمع، ولا شيء يُرسل."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么都不听，什么都不发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼都不聽，什麼都不傳送。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 듣지 않고, 아무것도 나가지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も聞かず、何も送りません。"
          }
        }
      }
    },
