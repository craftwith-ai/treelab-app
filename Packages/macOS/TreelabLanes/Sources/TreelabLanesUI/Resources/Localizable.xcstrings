    "treelab.privacy.key.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يقرؤه Ginkgo إلا لفتح محادثة، ولا يرسله إلا إلى OpenAI. لا يعرضه Treelab أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ga čita samo da otvori razgovor i šalje ga samo u OpenAI. Treelab ga nikad ne prikazuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo læser den kun for at åbne en samtale og sender den kun til OpenAI. Treelab viser den aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo liest ihn nur, um ein Gespräch zu öffnen, und sendet ihn nur an OpenAI. Treelab zeigt ihn nie an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo reads it only to open a conversation, and sends it only to OpenAI. Treelab never shows it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo solo la lee para abrir una conversación, y solo la envía a OpenAI. Treelab nunca la muestra."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ne la lit que pour ouvrir une conversation, et ne l’envoie qu’à OpenAI. Treelab ne l’affiche jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo la legge solo per aprire una conversazione e la invia solo a OpenAI. Treelab non la mostra mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo は会話を開くときだけキーを読み、OpenAI にだけ送ります。Treelab がキーを表示することはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo អានវាតែដើម្បីបើកការសន្ទនា ហើយផ្ញើវាតែទៅ OpenAI ប៉ុណ្ណោះ។ Treelab មិនដែលបង្ហាញវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo는 대화를 열 때만 키를 읽고, OpenAI에만 보냅니다. Treelab은 키를 절대 표시하지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo leser den bare for å åpne en samtale, og sender den bare til OpenAI. Treelab viser den aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo odczytuje go tylko po to, by otworzyć rozmowę, i wysyła go tylko do OpenAI. Treelab nigdy go nie pokazuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ginkgo só a lê para abrir uma conversa, e só a envia para a OpenAI. O Treelab nunca a mostra."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo читает его, только чтобы начать разговор, и отправляет только в OpenAI. Treelab никогда его не показывает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo อ่านคีย์นี้เพื่อเปิดบทสนทนาเท่านั้น และส่งไปที่ OpenAI เท่านั้น Treelab ไม่แสดงคีย์นี้เลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo onu yalnızca bir sohbet açmak için okur ve yalnızca OpenAI'a gönderir. Treelab onu asla göstermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo читає його лише для того, щоб почати розмову, і надсилає лише до OpenAI. Treelab ніколи його не показує."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 只在开启对话时读取它，并且只发送给 OpenAI。Treelab 从不显示它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 只在開啟對話時讀取它，而且只傳送給 OpenAI。Treelab 從不顯示它。"
          }
        }
      }
    },
