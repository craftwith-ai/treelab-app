    "treelab.welcome.overview.ginkgo.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "صوتك لقيادة مساراتك، إن أردت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj glas za upravljanje stazama, ako želiš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din stemme til at styre dine spor, hvis du vil."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Stimme, um deine Spuren zu steuern, wenn du willst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice to steer your lanes, if you want it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu voz para dirigir tus carriles, si quieres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta voix pour piloter tes couloirs, si tu veux."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua voce per guidare le tue corsie, se vuoi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "お望みなら、声でレーンを操作。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំឡេងរបស់អ្នក ដើម្បីបញ្ជាផ្លូវការងាររបស់អ្នក បើអ្នកចង់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하면 목소리로 통로를 조종할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Stemmen din til å styre sporene dine, hvis du vil."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój głos do sterowania torami, jeśli chcesz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua voz para guiar suas trilhas, se quiser."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Твой голос, чтобы управлять дорожками, если хочешь."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้เสียงของคุณควบคุมเลน ถ้าคุณต้องการ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstersen, kulvarlarını yönetmek için sesin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Твій голос, щоб керувати доріжками, якщо хочеш."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的声音掌控你的通道，如果你愿意。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的聲音掌控你的通道，如果你願意。"
          }
        }
      }
    },
