          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo запускается вместе с Treelab, с выключенным микрофоном, и работает в фоне."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
