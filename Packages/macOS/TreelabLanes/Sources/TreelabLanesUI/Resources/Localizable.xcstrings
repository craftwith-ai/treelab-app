    "treelab.welcome.trial.why": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا؟ لتحتفظ بتجربتك واشتراكك على كل أجهزة Mac لديك. بلا كلمة مرور: يصلك رابط لمرة واحدة في بريدك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zašto? Da zadržiš probu i pretplatu na svakom svom Macu. Bez lozinke: jednokratni link stiže u tvoje sanduče."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor? For at beholde din prøveperiode og dit abonnement på hver af dine Mac-computere. Ingen adgangskode: et engangslink kommer i din indbakke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum? Damit deine Testphase und dein Abo auf jedem deiner Macs gelten. Kein Passwort: Ein Einmal-Link kommt in dein Postfach."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why? To keep your trial and your subscription on each of your Macs. No password: a one-time link arrives in your inbox."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué? Para conservar tu prueba y tu suscripción en cada uno de tus Mac. Sin contraseña: te llega a la bandeja de entrada un enlace de un solo uso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi ? Pour garder ton essai et ton abonnement sur chacun de tes Mac. Pas de mot de passe : un lien à usage unique arrive dans ta boîte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perché? Per avere la tua prova e il tuo abbonamento su ognuno dei tuoi Mac. Niente password: ti arriva un link monouso nella casella di posta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜ？お使いのすべての Mac でトライアルとサブスクリプションを引き継ぐためです。パスワードは不要です。1 回限りのリンクが受信トレイに届きます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ហេតុអ្វី? ដើម្បីរក្សាការសាកល្បង និងការជាវរបស់អ្នកនៅលើ Mac នីមួយៗរបស់អ្នក។ គ្មានពាក្យសម្ងាត់៖ តំណប្រើតែម្តងនឹងមកដល់ប្រអប់សំបុត្ររបស់អ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜 필요할까요? 내 모든 Mac에서 체험과 구독을 유지하기 위해서입니다. 비밀번호는 필요 없습니다: 일회용 링크가 받은편지함으로 옵니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvorfor? For å beholde prøveperioden og abonnementet ditt på hver av Macene dine. Ingen passord: en engangslenke kommer i innboksen din."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po co? Żeby mieć swój okres próbny i subskrypcję na każdym ze swoich Maców. Bez hasła: jednorazowy link przyjdzie do twojej skrzynki."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Por quê? Para manter seu teste e sua assinatura em cada um dos seus Macs. Sem senha: um link de uso único chega na sua caixa de entrada."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зачем? Чтобы пробный период и подписка были с тобой на каждом твоём Mac. Без пароля: одноразовая ссылка придёт тебе на почту."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำไม? เพื่อให้ช่วงทดลองใช้และการสมัครสมาชิกของคุณใช้ได้บน Mac ทุกเครื่องของคุณ ไม่ต้องใช้รหัสผ่าน: ลิงก์แบบใช้ครั้งเดียวจะส่งไปที่กล่องจดหมายของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neden? Denemeni ve aboneliğini her Mac'inde korumak için. Şifre yok: gelen kutuna tek kullanımlık bir bağlantı gelir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Навіщо? Щоб пробний період і підписка були з тобою на кожному твоєму Mac. Без пароля: одноразове посилання прийде тобі на пошту."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么？为了在你的每台 Mac 上保留你的试用和订阅。无需密码：一次性链接会发到你的收件箱。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼？為了在你的每台 Mac 上保留你的試用和訂閱。無需密碼：一次性連結會寄到你的收件匣。"
          }
        }
      }
    },
