          "stringUnit": {
            "state": "translated",
            "value": "Descuento de equipo: −%@ en cada puesto a partir de %lld puestos"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remise d’équipe : −%@ sur tous les postes dès %lld postes"
