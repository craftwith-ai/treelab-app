    "treelab.account.notice.owner": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حسابك هو حساب المالك: لا شيء للدفع."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj nalog je vlasnički: ništa ne plaćaš."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konto er ejerens: intet at betale."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto ist das des Inhabers: nichts zu zahlen."
