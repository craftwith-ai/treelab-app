    "treelab.account.signInDetail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بلا كلمة مرور: يصلك رابط لمرة واحدة في بريدك. تبدأ التجربة المجانية عند أول تسجيل دخول لك، دون بطاقة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez lozinke: jednokratni link stiže u tvoje sanduče. Besplatna proba počinje pri prvoj prijavi, bez kartice."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen adgangskode: et engangslink kommer i din indbakke. Den gratis prøveperiode starter, første gang du logger ind, uden kort."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kein Passwort: Ein Einmal-Link kommt in dein Postfach. Die kostenlose Testphase beginnt bei deiner ersten Anmeldung, ohne Karte."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No password: a one-time link arrives in your inbox. The free trial starts at your first sign-in, no card needed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin contraseña: te llega a la bandeja de entrada un enlace de un solo uso. La prueba gratuita empieza con tu primer inicio de sesión, sin tarjeta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de mot de passe : un lien à usage unique arrive dans ta boîte. L’essai gratuit démarre à ta première connexion, sans carte."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente password: ti arriva un link monouso nella casella di posta. La prova gratuita parte al tuo primo accesso, senza carta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パスワードは不要です。1 回限りのリンクが受信トレイに届きます。無料トライアルは初回サインイン時に始まり、カードは不要です。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានពាក្យសម្ងាត់៖ តំណប្រើតែម្តងនឹងមកដល់ប្រអប់សំបុត្ររបស់អ្នក។ ការសាកល្បងឥតគិតថ្លៃចាប់ផ្តើមនៅពេលអ្នកចូលលើកដំបូង ដោយមិនត្រូវការកាត។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀번호는 필요 없습니다: 일회용 링크가 받은편지함으로 옵니다. 무료 체험은 처음 로그인할 때 시작되며, 카드가 필요 없습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen passord: en engangslenke kommer i innboksen din. Den gratis prøveperioden starter første gang du logger på, uten kort."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez hasła: jednorazowy link przyjdzie do twojej skrzynki. Darmowy okres próbny zaczyna się przy pierwszym logowaniu, bez karty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem senha: um link de uso único chega na sua caixa de entrada. O teste grátis começa no seu primeiro login, sem precisar de cartão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без пароля: одноразовая ссылка придёт тебе на почту. Бесплатный пробный период начинается с первого входа, карта не нужна."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องใช้รหัสผ่าน: ลิงก์แบบใช้ครั้งเดียวจะส่งไปที่กล่องจดหมายของคุณ ช่วงทดลองใช้ฟรีเริ่มเมื่อคุณลงชื่อเข้าใช้ครั้งแรก ไม่ต้องใช้บัตร"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şifre yok: gelen kutuna tek kullanımlık bir bağlantı gelir. Ücretsiz deneme ilk oturum açışında başlar, kart gerekmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без пароля: одноразове посилання прийде тобі на пошту. Безкоштовний пробний період починається з першого входу, картка не потрібна."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需密码：一次性链接会发到你的收件箱。免费试用从你首次登录时开始，无需信用卡。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需密碼：一次性連結會寄到你的收件匣。免費試用從你首次登入時開始，無需信用卡。"
          }
        }
      }
    },
