    "treelab.privacy.listen.command.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُفتح الميكروفون عندما تنقر، ويُغلق عندما تقول «توقف» أو بعد صمت."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon se uključi kad klikneš, a isključi se kad kažeš „stop“ ili nakon tišine."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen tændes, når du klikker, og slukkes, når du siger »stop«, eller efter en stilhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon geht an, wenn du klickst, und aus, wenn du „stopp“ sagst oder nach einer Stille."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone opens when you click, and closes when you say “stop” or after a silence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono se abre cuando haces clic y se cierra cuando dices «stop» o tras un silencio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro s’ouvre quand tu cliques, et se ferme quand tu dis « stop » ou après un silence."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono si apre quando clicchi e si chiude quando dici “stop” o dopo un silenzio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックするとマイクがオンになり、「ストップ」と言うか、しばらく黙るとオフになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មីក្រូហ្វូនបើកពេលអ្នកចុច ហើយបិទពេលអ្នកនិយាយ «ឈប់» ឬបន្ទាប់ពីភាពស្ងាត់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "클릭하면 마이크가 켜지고, “그만”이라고 하거나 잠시 조용하면 꺼집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen slås på når du klikker, og av når du sier «stopp» eller etter en stillhet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon włącza się, gdy klikniesz, a wyłącza, gdy powiesz „stop” albo po chwili ciszy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone liga quando você clica, e desliga quando você diz “pare” ou depois de um silêncio."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон включается, когда ты нажимаешь, и выключается, когда ты говоришь «стоп», или после тишины."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมค์จะเปิดเมื่อคุณคลิก และปิดเมื่อคุณพูดว่า “หยุด” หรือเมื่อเงียบไปสักพัก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon tıkladığında açılır, “dur” dediğinde ya da bir sessizlikten sonra kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон вмикається, коли ти натискаєш, і вимикається, коли ти кажеш «стоп», або після тиші."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击时麦克风打开，说“停”或沉默一会儿后关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊時麥克風開啟，說「停」或沉默一會兒後關閉。"
          }
        }
      }
    },
