    "treelab.welcome.overview.welcome.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab’s words, and what leaves your Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mots de Treelab, et ce qui sort de ton Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wörter von Treelab und was deinen Mac verlässt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las palabras de Treelab, y lo que sale de tu Mac."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "كلمات Treelab، وما يغادر جهاز Mac الخاص بك."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 的用语，以及什么会离开你的 Mac。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 的用語，以及什麼會離開你的 Mac。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab의 용어, 그리고 Mac 밖으로 나가는 것."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab の用語と、Mac から出ていくもの。"
          }
        }
      }
    },
    "treelab.welcome.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usage measurement, no tracking. Your work only leaves for Claude, and for OpenAI when you talk to Ginkgo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mesure de ton usage, aucun pistage. Ton travail ne sort que vers Claude, et vers OpenAI quand tu parles à Ginkgo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nutzungsmessung, kein Tracking. Deine Arbeit geht nur an Claude, und an OpenAI, wenn du mit Ginkgo sprichst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin medición de uso, sin rastreo. Tu trabajo solo sale hacia Claude, y hacia OpenAI cuando hablas con Ginkgo."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا قياس للاستخدام، ولا تتبّع. لا يخرج عملك إلا إلى Claude، وإلى OpenAI عندما تتحدث إلى Ginkgo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不统计使用情况，不跟踪。你的工作只会发给 Claude，以及在你和 Ginkgo 说话时发给 OpenAI。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不統計使用情況，不追蹤。你的工作只會傳給 Claude，以及在你和 Ginkgo 說話時傳給 OpenAI。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용량 측정도, 추적도 없습니다. 작업 내용은 Claude로만 나가고, Ginkgo와 대화할 때는 OpenAI로도 나갑니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用状況の計測もトラッキングもありません。作業内容が送られるのは Claude だけで、Ginkgo と話すときは OpenAI にも送られます。"
          }
        }
      }
    },
