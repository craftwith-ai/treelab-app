    "treelab.ginkgo.presence.update": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo needs an update to work with Treelab: update treelab, then try again. Nothing was started."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
