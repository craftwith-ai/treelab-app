    "treelab.privacy.key.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo reads it only to open a conversation, and sends it only to OpenAI. Treelab never shows it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ne la lit que pour ouvrir une conversation, et ne l’envoie qu’à OpenAI. Treelab ne l’affiche jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo liest ihn nur, um ein Gespräch zu öffnen, und sendet ihn nur an OpenAI. Treelab zeigt ihn nie an."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo solo la lee para abrir una conversación, y solo la envía a OpenAI. Treelab nunca la muestra."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يقرؤه Ginkgo إلا لفتح محادثة، ولا يرسله إلا إلى OpenAI. لا يعرضه Treelab أبدًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 只在开启对话时读取它，并且只发送给 OpenAI。Treelab 从不显示它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 只在開啟對話時讀取它，而且只傳送給 OpenAI。Treelab 從不顯示它。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo는 대화를 열 때만 키를 읽고, OpenAI에만 보냅니다. Treelab은 키를 절대 표시하지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo は会話を開くときだけキーを読み、OpenAI にだけ送ります。Treelab がキーを表示することはありません。"
          }
        }
      }
    },
