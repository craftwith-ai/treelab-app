    "treelab.ginkgo.help": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يغلق Escape أو «توقف» الميكروفون، وكذلك الصمت؛ ويعيدك Escape ثانٍ إلى المسارات. يستخدم Ginkgo مفتاح OpenAI الخاص بك، المحفوظ في سلسلة مفاتيح Mac."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc ili „stop“ isključuje mikrofon, kao i tišina; drugi Esc te vraća na staze. Ginkgo koristi tvoj OpenAI ključ, sačuvan u privjesku ključeva na Macu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc eller »stop« slukker mikrofonen, det gør stilhed også; et nyt tryk på Esc fører dig tilbage til sporene. Ginkgo bruger din OpenAI-nøgle, gemt i Macens nøglering."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape oder „stopp“ schaltet das Mikrofon aus, eine Stille auch; ein zweites Escape bringt dich zu den Spuren zurück. Ginkgo nutzt deinen OpenAI-Schlüssel aus dem Schlüsselbund des Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape or “stop” closes the microphone, so does a silence; a second Escape takes you back to the lanes. Ginkgo uses your OpenAI key, kept in the Mac’s keychain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escape o «stop» cierra el micrófono, un silencio también; un segundo Escape te devuelve a los carriles. Ginkgo usa tu clave de OpenAI, guardada en el llavero del Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échap ou « stop » ferme le micro, un silence aussi ; un second Échap ramène aux couloirs. Ginkgo utilise ta clé OpenAI, rangée dans le trousseau du Mac."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc o “stop” chiude il microfono, anche un silenzio; un secondo Esc ti riporta alle corsie. Ginkgo usa la tua chiave OpenAI, conservata nel portachiavi del Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc か「ストップ」でマイクがオフになり、沈黙でもオフになります。もう一度 Esc で通路に戻ります。Ginkgo は Mac のキーチェーンにある OpenAI キーを使います。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc ឬ «ឈប់» បិទមីក្រូហ្វូន ភាពស្ងាត់ក៏ដូចគ្នា។ ចុច Esc ម្តងទៀតនាំអ្នកត្រឡប់ទៅផ្លូវការងារវិញ។ Ginkgo ប្រើសោ OpenAI របស់អ្នក ដែលរក្សាទុកក្នុង Keychain របស់ Mac។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc 또는 “그만”으로 마이크가 꺼지고, 침묵해도 꺼집니다. Esc를 한 번 더 누르면 통로로 돌아갑니다. Ginkgo는 Mac 키체인에 보관된 OpenAI 키를 사용합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc eller «stopp» slår av mikrofonen, det gjør også stillhet; et nytt trykk på Esc tar deg tilbake til sporene. Ginkgo bruker OpenAI-nøkkelen din, lagret i nøkkelringen på Macen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc lub „stop” wyłącza mikrofon, cisza też; drugie Esc zabiera cię z powrotem do torów. Ginkgo używa twojego klucza OpenAI, trzymanego w pęku kluczy Maca."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc ou “pare” desliga o microfone, um silêncio também; um segundo Esc leva você de volta às trilhas. O Ginkgo usa sua chave da OpenAI, guardada nas Chaves do Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc или «стоп» выключает микрофон, как и тишина; второе нажатие Esc возвращает к дорожкам. Ginkgo использует твой ключ OpenAI, который хранится в связке ключей Mac."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc หรือ “หยุด” จะปิดไมค์ ความเงียบก็เช่นกัน กด Esc อีกครั้งเพื่อกลับไปที่เลน Ginkgo ใช้คีย์ OpenAI ของคุณ ซึ่งเก็บไว้ในพวงกุญแจของ Mac"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc ya da “dur” mikrofonu kapatır, bir sessizlik de; ikinci bir Esc seni kulvarlara geri götürür. Ginkgo, Mac'in anahtar zincirinde saklanan OpenAI anahtarını kullanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Esc або «стоп» вимикає мікрофон, як і тиша; друге натискання Esc повертає до доріжок. Ginkgo використовує твій ключ OpenAI, що зберігається у в’язці ключів Mac."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Esc 或说“停”会关闭麦克风，沉默也会；再按一次 Esc 返回通道。Ginkgo 使用你存放在 Mac 钥匙串中的 OpenAI 密钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按 Esc 或說「停」會關閉麥克風，沉默也會；再按一次 Esc 返回通道。Ginkgo 使用你存放在 Mac 鑰匙圈中的 OpenAI 金鑰。"
          }
        }
      }
    },
