    "treelab.appearance.motion.allowed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today: animations allowed. If the Mac reduces motion, Treelab turns them off, Ginkgo included."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui : animations permises. Si le Mac réduit les animations, Treelab les coupe, Ginkgo compris."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuell: Animationen erlaubt. Wenn der Mac Bewegung reduziert, schaltet Treelab sie aus, auch bei Ginkgo."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora: animaciones permitidas. Si el Mac reduce el movimiento, Treelab las desactiva, Ginkgo incluido."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاليًا: الرسوم المتحركة مسموحة. إذا قلّل Mac الحركة، يوقفها Treelab، بما في ذلك Ginkgo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前：允许动画。如果 Mac 减弱动态效果，Treelab 会关闭动画，包括 Ginkgo 的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前：允許動畫。如果 Mac 減少動態效果，Treelab 會關閉動畫，包括 Ginkgo 的。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재: 애니메이션 허용. Mac에서 동작 줄이기를 켜면 Treelab이 Ginkgo를 포함해 애니메이션을 끕니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在：アニメーションは許可されています。Mac で動きを減らす設定にすると、Treelab は Ginkgo も含めてアニメーションをオフにします。"
          }
        }
      }
    },
