    "treelab.welcome.ginkgo.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo، صوتك لقيادة مساراتك"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, tvoj glas za upravljanje stazama"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, din stemme til at styre dine spor"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, deine Stimme, um deine Spuren zu steuern"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, your voice to steer your lanes"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, tu voz para dirigir tus carriles"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, ta voix pour piloter tes couloirs"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, la tua voce per guidare le tue corsie"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo、声でレーンを操作"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo សំឡេងរបស់អ្នក ដើម្បីបញ្ជាផ្លូវការងាររបស់អ្នក"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, 목소리로 통로를 조종하세요"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, stemmen din til å styre sporene dine"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, twój głos do sterowania torami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, sua voz para guiar suas trilhas"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo — твой голос, чтобы управлять дорожками"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ใช้เสียงของคุณควบคุมเลน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, kulvarlarını yönetmek için sesin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo — твій голос, щоб керувати доріжками"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo，用你的声音掌控你的通道"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo，用你的聲音掌控你的通道"
          }
        }
      }
    },
    "treelab.welcome.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدفع Treelab مشاريعك إلى الأمام مع Claude، عملًا تلو الآخر، ولا يخبرك إلا عندما يحتاج إليك. أربع كلمات عليك معرفتها:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab uz Claude gura tvoje projekte naprijed, posao po posao, i javlja ti se samo kad te treba. Četiri riječi koje trebaš znati:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab bringer dine projekter videre med Claude, én opgave ad gangen, og siger kun til, når den har brug for dig. Fire ord, du skal kende:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab bringt deine Projekte mit Claude voran, ein Vorhaben nach dem anderen, und meldet sich nur, wenn es dich braucht. Vier Wörter, die du kennen solltest:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab moves your projects forward with Claude, one piece of work at a time, and tells you only when it needs you. Four words to know:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab hace avanzar tus proyectos con Claude, un trabajo cada vez, y solo te avisa cuando te necesita. Cuatro palabras que conviene conocer:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab fait avancer tes projets avec Claude, chantier par chantier, et te dit seulement quand il a besoin de toi. Quatre mots à connaître :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab fa avanzare i tuoi progetti con Claude, un lavoro alla volta, e ti avvisa solo quando ha bisogno di te. Quattro parole da conoscere:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab は Claude と一緒に作業をひとつずつ進めてプロジェクトを前に進め、あなたが必要なときだけ知らせます。知っておきたい 4 つの言葉："
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab ជំរុញគម្រោងរបស់អ្នកទៅមុខជាមួយ Claude ម្តងមួយការងារ ហើយប្រាប់អ្នកតែពេលវាត្រូវការអ្នកប៉ុណ្ណោះ។ ពាក្យបួនដែលគួរដឹង៖"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab은 Claude와 함께 프로젝트를 한 작업씩 진행하고, 내가 필요할 때만 알려 줍니다. 알아 둘 네 단어:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab tar prosjektene dine videre med Claude, én oppgave om gangen, og sier bare fra når den trenger deg. Fire ord å kjenne til:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab posuwa twoje projekty naprzód z Claude, jedno zadanie naraz, i odzywa się tylko wtedy, gdy cię potrzebuje. Cztery słowa, które warto znać:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Treelab faz seus projetos avançarem com o Claude, uma frente de trabalho por vez, e só avisa quando precisa de você. Quatro palavras para conhecer:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab двигает твои проекты вперёд вместе с Claude, задачу за задачей, и зовёт тебя, только когда без тебя не обойтись. Четыре слова, которые стоит знать:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab ช่วยให้โปรเจกต์ของคุณเดินหน้าไปกับ Claude ทีละงาน และจะบอกคุณเฉพาะเมื่อต้องการคุณ คำสี่คำที่ควรรู้:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab projelerini Claude ile, her seferinde bir iş olmak üzere ilerletir ve sana yalnızca ihtiyacı olduğunda haber verir. Bilmen gereken dört kelime:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab просуває твої проєкти разом із Claude, завдання за завданням, і кличе тебе, лише коли без тебе не обійтися. Чотири слова, які варто знати:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 借助 Claude 推进你的项目，一次一项工作，只在需要你时才告诉你。需要了解的四个词："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 藉助 Claude 推進你的專案，一次一項工作，只在需要你時才告訴你。需要了解的四個詞："
          }
        }
      }
    },
