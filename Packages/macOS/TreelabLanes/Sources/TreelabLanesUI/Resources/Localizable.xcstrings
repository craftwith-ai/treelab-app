    "treelab.settings.nextVersion.account": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account comes with the next version of treelab. Subscribing and your OpenAI key already work."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte arrive avec la prochaine version de treelab. S’abonner et ta clé OpenAI marchent déjà."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto kommt mit der nächsten Version von treelab. Abonnieren und dein OpenAI-Schlüssel funktionieren schon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta llega con la próxima versión de treelab. La suscripción y tu clave de OpenAI ya funcionan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي حسابك مع الإصدار القادم من treelab. الاشتراك ومفتاح OpenAI الخاص بك يعملان من الآن."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的账户将随下一版 treelab 推出。订阅和你的 OpenAI 密钥已经可以使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的帳號將隨下一版 treelab 推出。訂閱和你的 OpenAI 金鑰已經可以使用。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 기능은 다음 버전의 treelab에서 제공됩니다. 구독과 OpenAI 키는 이미 사용할 수 있습니다."
          }
        },
