    "treelab.welcome.word.tower.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The watcher that delivers and restarts your lanes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le veilleur qui livre et relance tes couloirs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Wächter, der deine Spuren ausliefert und neu startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El vigilante que entrega y reinicia tus carriles."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الحارس الذي يسلّم مساراتك ويعيد تشغيلها."
          }
        },
        "zh-Hans": {
