    "treelab.ginkgo.mic.on.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُرسل صوتك إلى OpenAI خلال هذه المحادثة"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "tvoj glas ide u OpenAI tokom ovog razgovora"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "din stemme sendes til OpenAI under denne samtale"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "deine Stimme geht während dieses Gesprächs an OpenAI"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "your voice goes to OpenAI during this conversation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "tu voz va a OpenAI durante esta conversación"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ta voix part chez OpenAI pendant cette conversation"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "la tua voce va a OpenAI durante questa conversazione"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この会話のあいだ、声は OpenAI に送られます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "សំឡេងរបស់អ្នកទៅកាន់ OpenAI ក្នុងអំឡុងការសន្ទនានេះ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 대화 동안 목소리가 OpenAI로 전송됩니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "stemmen din sendes til OpenAI under denne samtalen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "twój głos trafia do OpenAI podczas tej rozmowy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "sua voz vai para a OpenAI durante esta conversa"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "твой голос уходит в OpenAI во время этого разговора"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เสียงของคุณจะถูกส่งไปที่ OpenAI ระหว่างบทสนทนานี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "bu sohbet boyunca sesin OpenAI'a gider"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "твій голос іде до OpenAI під час цієї розмови"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本次对话期间你的声音会发送到 OpenAI"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本次對話期間你的聲音會傳送到 OpenAI"
          }
        }
      }
    },
