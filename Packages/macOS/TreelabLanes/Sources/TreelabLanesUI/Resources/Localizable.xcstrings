    "treelab.settings.nextVersion.account": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي حسابك مع الإصدار القادم من treelab. الاشتراك ومفتاح OpenAI الخاص بك يعملان من الآن."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tvoj nalog stiže sa sljedećom verzijom alata treelab. Pretplata i tvoj OpenAI ključ već rade."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din konto kommer med næste version af treelab. Abonnement og din OpenAI-nøgle virker allerede."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Konto kommt mit der nächsten Version von treelab. Abonnieren und dein OpenAI-Schlüssel funktionieren schon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your account comes with the next version of treelab. Subscribing and your OpenAI key already work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu cuenta llega con la próxima versión de treelab. La suscripción y tu clave de OpenAI ya funcionan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton compte arrive avec la prochaine version de treelab. S’abonner et ta clé OpenAI marchent déjà."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo account arriva con la prossima versione di treelab. L’abbonamento e la tua chiave OpenAI funzionano già."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アカウント機能は次のバージョンの treelab で登場します。サブスクリプション登録と OpenAI キーはすでに使えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គណនីរបស់អ្នកនឹងមកជាមួយកំណែបន្ទាប់របស់ treelab។ ការជាវ និងសោ OpenAI របស់អ្នកដំណើរការរួចហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정 기능은 다음 버전의 treelab에서 제공됩니다. 구독과 OpenAI 키는 이미 사용할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontoen din kommer med neste versjon av treelab. Abonnement og OpenAI-nøkkelen din fungerer allerede."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje konto pojawi się w następnej wersji treelab. Subskrypcja i twój klucz OpenAI już działają."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sua conta chega com a próxima versão do treelab. Assinar e sua chave da OpenAI já funcionam."
