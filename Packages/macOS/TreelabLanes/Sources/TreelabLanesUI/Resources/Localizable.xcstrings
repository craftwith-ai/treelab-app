    "treelab.welcome.ginkgo.keyDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stored in the Mac’s keychain by lab, never sent to Treelab."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rangée dans le trousseau du Mac par lab, jamais envoyée à Treelab."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von lab im Schlüsselbund des Mac gespeichert, nie an Treelab gesendet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guardada por lab en el llavero del Mac, nunca enviada a Treelab."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحفظه lab في سلسلة مفاتيح Mac، ولا يُرسل أبدًا إلى Treelab."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "由 lab 存入 Mac 的钥匙串，绝不会发送给 Treelab。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "由 lab 存入 Mac 的鑰匙圈，絕不會傳送給 Treelab。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "lab이 Mac 키체인에 저장하며, Treelab으로는 절대 보내지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "lab が Mac のキーチェーンに保存し、Treelab に送られることはありません。"
          }
        }
      }
    },
    "treelab.welcome.ginkgo.listenTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When Ginkgo listens"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand Ginkgo écoute"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wann Ginkgo zuhört"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuándo escucha Ginkgo"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "متى يستمع Ginkgo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 何时在听"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 何時在聽"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo가 듣는 시점"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo が聞き取るとき"
          }
        }
      }
    },
    "treelab.welcome.ginkgo.mic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For Ginkgo to hear you, only when you decide. Ginkgo will ask you for it at your first conversation, to hear you. Treelab never listens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que Ginkgo t’entende, seulement quand tu le décides. Ginkgo te le demandera à ta première conversation, pour t’entendre. Treelab n’écoute jamais."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit Ginkgo dich hört, nur wenn du es entscheidest. Ginkgo fragt dich beim ersten Gespräch danach, um dich zu hören. Treelab hört nie zu."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para que Ginkgo te oiga, solo cuando tú decidas. Ginkgo te lo pedirá en tu primera conversación, para oírte. Treelab nunca escucha."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ليسمعك Ginkgo، فقط عندما تقرر. سيطلبه منك Ginkgo في أول محادثة لك، ليسمعك. لا يستمع Treelab أبدًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让 Ginkgo 听到你，只在你决定的时候。Ginkgo 会在你第一次对话时请求使用麦克风，以便听到你。Treelab 从不收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "讓 Ginkgo 聽到你，只在你決定的時候。Ginkgo 會在你第一次對話時請求使用麥克風，以便聽到你。Treelab 從不收聽。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내가 원할 때만 Ginkgo가 내 목소리를 들을 수 있도록. Ginkgo가 첫 대화 때 내 목소리를 들으려고 마이크 권한을 요청합니다. Treelab은 절대 듣지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あなたが決めたときだけ、Ginkgo があなたの声を聞くためです。Ginkgo は最初の会話のとき、あなたの声を聞くためにマイクの許可を求めます。Treelab が聞くことはありません。"
          }
        }
      }
    },
    "treelab.welcome.ginkgo.micTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why the microphone?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi le micro ?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum das Mikrofon?"
