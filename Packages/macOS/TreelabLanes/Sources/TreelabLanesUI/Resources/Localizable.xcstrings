    "treelab.ginkgo.confirm.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “yes” within 2 minutes; without your “yes”, nothing happens."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dis « oui » dans les 2 minutes ; sans ton « oui », rien ne se passe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sag innerhalb von 2 Minuten „ja“; ohne dein „ja“ passiert nichts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Di «sí» en 2 minutos; sin tu «sí», no pasa nada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قل «نعم» خلال دقيقتين؛ من دون «نعم» منك لا يحدث شيء."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在 2 分钟内说“是”；没有你的“是”，什么都不会发生。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在 2 分鐘內說「是」；沒有你的「是」，什麼都不會發生。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "2분 안에 “네”라고 말하세요. “네”가 없으면 아무 일도 일어나지 않습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2 分以内に「はい」と言ってください。「はい」がなければ何も起きません。"
          }
        }
      }
    },
    "treelab.ginkgo.confirm.left": {
