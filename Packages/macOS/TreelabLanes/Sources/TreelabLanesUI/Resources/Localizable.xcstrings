    "treelab.welcome.trial.then": {
      "comment": "Prices from lab's offer.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بعدها، إن تابعت: %@ شهريًا أو %@ سنويًا، لكل مقعد."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatim, ako nastaviš: %@ mjesečno ili %@ godišnje, po mjestu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Derefter, hvis du fortsætter: %@ om måneden eller %@ om året, pr. plads."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Danach, wenn du weitermachst: %@ im Monat oder %@ im Jahr, pro Platz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Then, if you go on: %@ a month or %@ a year, per seat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Después, si sigues: %@ al mes o %@ al año, por puesto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensuite, si tu continues : %@ par mois ou %@ par an, par poste."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Poi, se continui: %@ al mese o %@ all’anno, a postazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "その後も続ける場合：1 シートあたり月 %@ または年 %@。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "បន្ទាប់មក បើអ្នកបន្ត៖ %@ ក្នុងមួយខែ ឬ %@ ក្នុងមួយឆ្នាំ ក្នុងមួយសិទ្ធិប្រើ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이후 계속하려면: 시트당 월 %@ 또는 연 %@."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Deretter, hvis du fortsetter: %@ i måneden eller %@ i året, per plass."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potem, jeśli zostaniesz: %@ miesięcznie lub %@ rocznie, za stanowisko."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Depois, se continuar: %@ por mês ou %@ por ano, por assento."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Потом, если продолжишь: %@ в месяц или %@ в год за место."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หลังจากนั้น หากใช้ต่อ: %@ ต่อเดือน หรือ %@ ต่อปี ต่อสิทธิ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra, devam edersen: koltuk başına aylık %@ ya da yıllık %@."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Потім, якщо продовжиш: %@ на місяць або %@ на рік за місце."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后如果继续：每个席位每月 %@ 或每年 %@。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之後如果繼續：每個席位每月 %@ 或每年 %@。"
          }
        }
      }
    },
    "treelab.welcome.trial.title": {
      "extractionState": "manual",
