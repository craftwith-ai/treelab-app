    "treelab.ginkgo.problem.mic": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرفض Mac منح الميكروفون لـ Ginkgo: اسمح به في إعدادات النظام › الخصوصية والأمن › الميكروفون."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ne da mikrofon za Ginkgo: dozvoli ga u Postavkama sistema › Privatnost i sigurnost › Mikrofon."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen nægter Ginkgo adgang til mikrofonen: tillad det i Systemindstillinger › Anonymitet og sikkerhed › Mikrofon."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Mac verweigert Ginkgo das Mikrofon: Erlaube es in Systemeinstellungen › Datenschutz & Sicherheit › Mikrofon."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Mac refuses the microphone to Ginkgo: allow it in System Settings › Privacy & Security › Microphone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El Mac niega el micrófono a Ginkgo: permítelo en Ajustes del Sistema › Privacidad y seguridad › Micrófono."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le Mac refuse le micro à Ginkgo : autorise-le dans Réglages Système › Confidentialité et sécurité › Microphone."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Mac nega il microfono a Ginkgo: consentilo in Impostazioni di Sistema › Privacy e sicurezza › Microfono."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac が Ginkgo のマイク使用を拒否しています。システム設定 › プライバシーとセキュリティ › マイク で許可してください。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac មិនអនុញ្ញាតឲ្យ Ginkgo ប្រើមីក្រូហ្វូនទេ៖ អនុញ្ញាតនៅក្នុង System Settings › Privacy & Security › Microphone។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac이 Ginkgo의 마이크 사용을 거부합니다: 시스템 설정 › 개인정보 보호 및 보안 › 마이크에서 허용하세요."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Macen nekter Ginkgo tilgang til mikrofonen: gi tillatelse i Systeminnstillinger › Personvern og sikkerhet › Mikrofon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac nie daje Ginkgo dostępu do mikrofonu: zezwól w Ustawieniach systemowych › Prywatność i ochrona › Mikrofon."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Mac bloqueia o microfone para o Ginkgo: permita em Ajustes do Sistema › Privacidade e Segurança › Microfone."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не даёт Ginkgo доступ к микрофону: разреши его в Системные настройки › Конфиденциальность и безопасность › Микрофон."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac ไม่อนุญาตให้ Ginkgo ใช้ไมค์: อนุญาตได้ที่ การตั้งค่าระบบ › ความเป็นส่วนตัวและความปลอดภัย › ไมโครโฟน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac, Ginkgo'ya mikrofon izni vermiyor: Sistem Ayarları › Gizlilik ve Güvenlik › Mikrofon bölümünden izin ver."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac не дає Ginkgo доступу до мікрофона: дозволь його в Системні параметри › Приватність і безпека › Мікрофон."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 拒绝让 Ginkgo 使用麦克风：请在“系统设置 › 隐私与安全性 › 麦克风”中允许。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 拒絕讓 Ginkgo 使用麥克風：請在「系統設定 › 隱私權與安全性 › 麥克風」中允許。"
          }
        }
      }
    },
