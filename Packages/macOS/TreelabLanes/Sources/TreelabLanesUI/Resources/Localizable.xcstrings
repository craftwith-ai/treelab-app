    "treelab.appearance.motion.allowed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حاليًا: الرسوم المتحركة مسموحة. إذا قلّل Mac الحركة، يوقفها Treelab، بما في ذلك Ginkgo."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Danas: animacije dozvoljene. Ako Mac smanjuje kretanje, Treelab ih isključuje, uključujući Ginkgo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag: animationer tilladt. Hvis Macen reducerer bevægelse, slår Treelab dem fra, også Ginkgo."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktuell: Animationen erlaubt. Wenn der Mac Bewegung reduziert, schaltet Treelab sie aus, auch bei Ginkgo."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Today: animations allowed. If the Mac reduces motion, Treelab turns them off, Ginkgo included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora: animaciones permitidas. Si el Mac reduce el movimiento, Treelab las desactiva, Ginkgo incluido."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aujourd’hui : animations permises. Si le Mac réduit les animations, Treelab les coupe, Ginkgo compris."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi: animazioni consentite. Se il Mac riduce il movimento, Treelab le spegne, Ginkgo compreso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在：アニメーションは許可されています。Mac で動きを減らす設定にすると、Treelab は Ginkgo も含めてアニメーションをオフにします。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ថ្ងៃនេះ៖ អនុញ្ញាតចលនា។ ប្រសិនបើ Mac កាត់បន្ថយចលនា Treelab នឹងបិទវា រួមទាំង Ginkgo។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재: 애니메이션 허용. Mac에서 동작 줄이기를 켜면 Treelab이 Ginkgo를 포함해 애니메이션을 끕니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "I dag: animasjoner tillatt. Hvis Macen reduserer bevegelse, slår Treelab dem av, også Ginkgo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś: animacje dozwolone. Jeśli Mac ogranicza ruch, Treelab je wyłącza, Ginkgo też."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoje: animações permitidas. Se o Mac reduzir o movimento, o Treelab as desliga, inclusive no Ginkgo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сейчас: анимации разрешены. Если на Mac включено уменьшение движения, Treelab их отключает, включая Ginkgo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตอนนี้: อนุญาตภาพเคลื่อนไหว ถ้า Mac ลดการเคลื่อนไหว Treelab จะปิดภาพเคลื่อนไหว รวมถึงของ Ginkgo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an: animasyonlara izin veriliyor. Mac hareketi azaltırsa Treelab onları kapatır, Ginkgo dahil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зараз: анімації дозволено. Якщо на Mac увімкнено зменшення руху, Treelab їх вимикає, зокрема в Ginkgo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前：允许动画。如果 Mac 减弱动态效果，Treelab 会关闭动画，包括 Ginkgo 的。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "目前：允許動畫。如果 Mac 減少動態效果，Treelab 會關閉動畫，包括 Ginkgo 的。"
          }
        }
      }
    },
