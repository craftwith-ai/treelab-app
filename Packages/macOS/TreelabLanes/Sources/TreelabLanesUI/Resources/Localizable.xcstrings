    "treelab.privacy.speak.intro": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عندما يبدأ مسار في انتظارك، يعلن Ginkgo ذلك بصوت عالٍ:"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kad te staza počne čekati, Ginkgo ti to kaže naglas:"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et spor begynder at vente på dig, siger Ginkgo det højt:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn eine Spur auf dich zu warten beginnt, sagt Ginkgo es laut:"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When a lane starts waiting for you, Ginkgo says so out loud:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando un carril empieza a esperarte, Ginkgo te lo dice en voz alta:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand un couloir se met à t’attendre, Ginkgo te l’annonce à voix haute :"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando una corsia inizia ad aspettarti, Ginkgo lo dice ad alta voce:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンがあなた待ちになると、Ginkgo が声に出して知らせます："
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ពេលផ្លូវការងារចាប់ផ្តើមរង់ចាំអ្នក Ginkgo ប្រាប់អ្នកដោយសំឡេង៖"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로가 나를 기다리기 시작하면 Ginkgo가 소리 내어 알려 줍니다:"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et spor begynner å vente på deg, sier Ginkgo det høyt:"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy tor zaczyna na ciebie czekać, Ginkgo mówi o tym na głos:"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma trilha começa a esperar por você, o Ginkgo avisa em voz alta:"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда дорожка начинает ждать тебя, Ginkgo сообщает об этом вслух:"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเลนเริ่มรอคุณ Ginkgo จะบอกออกเสียง:"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kulvar seni beklemeye başladığında Ginkgo bunu sesli söyler:"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли доріжка починає чекати на тебе, Ginkgo повідомляє про це вголос:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当某个通道开始等你时，Ginkgo 会大声说出来："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "當某個通道開始等你時，Ginkgo 會大聲說出來："
          }
        }
      }
    },
