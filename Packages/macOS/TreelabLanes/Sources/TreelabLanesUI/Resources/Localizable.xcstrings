    "treelab.ginkgo.conversation.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُكتب ما تقوله، ثم ما يجيب به Ginkgo"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "ono što kažeš se zapisuje, a zatim Ginkgov odgovor"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "det, du siger, skrives ned, derefter Ginkgos svar"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "was du sagst, wird geschrieben, dann Ginkgos Antwort"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "what you say is written, then Ginkgo’s answer"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "lo que dices se escribe, luego la respuesta de Ginkgo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ce que tu dis s’écrit, puis ce que Ginkgo répond"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "quello che dici viene scritto, poi la risposta di Ginkgo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "話した内容が書かれ、続いて Ginkgo の答えが書かれます"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្វីដែលអ្នកនិយាយត្រូវបានសរសេរ បន្ទាប់មកចម្លើយរបស់ Ginkgo"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "말한 내용이 적히고, 이어서 Ginkgo의 답이 적힙니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "det du sier, skrives ned, så svaret fra Ginkgo"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "to, co mówisz, jest zapisywane, potem odpowiedź Ginkgo"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "o que você diz é escrito, depois a resposta do Ginkgo"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "твои слова записываются, затем ответ Ginkgo"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สิ่งที่คุณพูดจะถูกเขียนไว้ ตามด้วยคำตอบของ Ginkgo"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "söylediklerin yazılır, ardından Ginkgo'nun yanıtı"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "твої слова записуються, потім відповідь Ginkgo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你说的话会写下来，然后是 Ginkgo 的回答"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你說的話會寫下來，然後是 Ginkgo 的回答"
          }
        }
      }
    },
    "treelab.ginkgo.conversation.empty": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انقر «تكلّم» أو Ginkgo في الشريط الجانبي: يُفتح الميكروفون، ويُغلق عندما تقول «توقف»."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikni „Pričaj“ ili Ginkgo na bočnoj traci: mikrofon se uključi, a isključi se kad kažeš „stop“."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Klik på »Tal« eller på Ginkgo i sidepanelet: mikrofonen tændes og slukkes, når du siger »stop«."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Klicke auf „Sprechen“ oder auf Ginkgo in der Seitenleiste: Das Mikrofon geht an und wieder aus, wenn du „stopp“ sagst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click “Talk” or Ginkgo in the sidebar: the microphone opens, and closes when you say “stop”."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz clic en «Hablar» o en Ginkgo en la barra lateral: el micrófono se abre y se cierra cuando dices «stop»."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique sur « Parler » ou sur Ginkgo dans la barre : le micro s’ouvre, et se ferme quand tu dis « stop »."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Clicca su “Parla” o su Ginkgo nella barra laterale: il microfono si apre e si chiude quando dici “stop”."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「話す」またはサイドバーの Ginkgo をクリックすると、マイクがオンになり、「ストップ」と言うとオフになります。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ចុច «និយាយ» ឬ Ginkgo នៅរបារចំហៀង៖ មីក្រូហ្វូនបើក ហើយបិទវិញពេលអ្នកនិយាយ «ឈប់»។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "“말하기” 또는 사이드바의 Ginkgo를 클릭하세요. 마이크가 켜지고, “그만”이라고 하면 꺼집니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Klikk på «Snakk» eller på Ginkgo i sidepanelet: mikrofonen slås på, og av når du sier «stopp»."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kliknij „Mów” albo Ginkgo na pasku bocznym: mikrofon się włącza, a wyłącza, gdy powiesz „stop”."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Clique em “Falar” ou no Ginkgo na barra lateral: o microfone liga e desliga quando você diz “pare”."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажми «Говорить» или Ginkgo на боковой панели: микрофон включится и выключится, когда ты скажешь «стоп»."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คลิก “พูด” หรือ Ginkgo ในแถบด้านข้าง: ไมค์จะเปิด และปิดเมื่อคุณพูดว่า “หยุด”"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "“Konuş”a ya da kenar çubuğundaki Ginkgo'ya tıkla: mikrofon açılır, “dur” dediğinde kapanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Натисни «Говорити» або Ginkgo на бічній панелі: мікрофон увімкнеться і вимкнеться, коли ти скажеш «стоп»."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击“说话”或侧栏中的 Ginkgo：麦克风打开，说“停”时关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "點擊「說話」或側欄中的 Ginkgo：麥克風開啟，說「停」時關閉。"
          }
        }
      }
    },
