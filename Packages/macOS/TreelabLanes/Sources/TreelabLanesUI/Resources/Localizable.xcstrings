        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué el micrófono?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا الميكروفون؟"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
