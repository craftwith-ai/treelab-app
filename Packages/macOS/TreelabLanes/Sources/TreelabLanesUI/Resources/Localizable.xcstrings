    "treelab.privacy.nobody.what": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No usage measurement, no tracking, no error report sent"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune mesure de ton usage, aucun pistage, aucun rapport d’erreur envoyé"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Nutzungsmessung, kein Tracking, kein Fehlerbericht wird gesendet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin medición de uso, sin rastreo, sin informes de errores enviados"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا قياس للاستخدام، ولا تتبّع، ولا إرسال لتقارير الأخطاء"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不统计使用情况，不跟踪，不发送错误报告"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不統計使用情況，不追蹤，不傳送錯誤報告"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용량 측정 없음, 추적 없음, 오류 보고서 전송 없음"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "利用状況の計測なし、トラッキングなし、エラーレポートの送信なし"
          }
        }
      }
    },
