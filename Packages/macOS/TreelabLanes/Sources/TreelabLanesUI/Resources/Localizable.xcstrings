        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로가 작업할 때, 내 Claude 계정으로"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Når et spor jobber, med Claude-kontoen din"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiedy tor pracuje, z twoim kontem Claude"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando uma trilha trabalha, com sua conta do Claude"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Когда дорожка работает, через твой аккаунт Claude"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เมื่อเลนทำงาน ด้วยบัญชี Claude ของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kulvar çalışırken, Claude hesabınla"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коли доріжка працює, через твій акаунт Claude"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
