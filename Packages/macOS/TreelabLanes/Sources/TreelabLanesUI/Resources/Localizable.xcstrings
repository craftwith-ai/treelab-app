    "treelab.ginkgo.presence.update": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo needs an update to work with Treelab: update treelab, then try again. Nothing was started."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo a besoin d’une mise à jour pour marcher avec Treelab : mets à jour treelab, puis réessaie. Rien n’a été lancé."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo braucht ein Update, um mit Treelab zu arbeiten: Aktualisiere treelab und versuche es erneut. Nichts wurde gestartet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo necesita una actualización para funcionar con Treelab: actualiza treelab y vuelve a intentarlo. No se inició nada."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Ginkgo إلى تحديث ليعمل مع Treelab: حدّث treelab ثم أعد المحاولة. لم يُشغَّل شيء."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 需要更新才能配合 Treelab：请更新 treelab 后重试。没有启动任何东西。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo 需要更新才能配合 Treelab：請更新 treelab 後重試。沒有啟動任何東西。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo가 Treelab과 작동하려면 업데이트가 필요합니다: treelab을 업데이트한 뒤 다시 시도하세요. 아무것도 시작하지 않았습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab と連携するには Ginkgo の更新が必要です。treelab を更新してから再試行してください。何も起動していません。"
          }
        }
      }
    },
    "treelab.ginkgo.presence.version": {
