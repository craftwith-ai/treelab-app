    "treelab.welcome.overview.notifications.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لتعرف متى ينتظرك مسار."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Da znaš kad te staza čeka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For at vide, når et spor venter på dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit du weißt, wann eine Spur auf dich wartet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To know when a lane waits for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Para saber cuándo un carril te espera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour savoir quand un couloir t’attend."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per sapere quando una corsia ti aspetta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンがあなた待ちになったときに知るため。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ដើម្បីដឹងពេលផ្លូវការងាររង់ចាំអ្នក។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로가 나를 기다릴 때 알 수 있도록."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For å vite når et spor venter på deg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żeby wiedzieć, kiedy tor na ciebie czeka."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Para saber quando uma trilha espera por você."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы знать, когда дорожка ждёт тебя."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพื่อให้รู้เมื่อเลนรอคุณอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir kulvar seni beklediğinde bilmek için."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб знати, коли доріжка чекає на тебе."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以便知道何时有通道在等你。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "以便知道何時有通道在等你。"
          }
        }
      }
    },
    "treelab.welcome.overview.title": {
      "extractionState": "manual",
      "localizations": {
