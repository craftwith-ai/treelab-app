    "treelab.privacy.listen.name.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يُتعرّف على اسمه على Mac الخاص بك وحده؛ ولا يذهب شيء إلى OpenAI قبل ذلك."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Njegovo ime se prepoznaje samo na tvom Macu; ništa ne ide u OpenAI prije toga."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet genkendes kun på din Mac; intet sendes til OpenAI før det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sein Name wird nur auf deinem Mac erkannt; vorher geht nichts an OpenAI."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Its name is recognized on your Mac alone; nothing goes to OpenAI before."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Su nombre se reconoce solo en tu Mac; antes no va nada a OpenAI."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son nom est reconnu sur ton Mac seul ; rien ne part chez OpenAI avant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il suo nome viene riconosciuto solo sul tuo Mac; prima non va niente a OpenAI."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の認識はあなたの Mac だけで行います。それまでは何も OpenAI に送りません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ឈ្មោះរបស់វាត្រូវបានស្គាល់តែនៅលើ Mac របស់អ្នកប៉ុណ្ណោះ។ មុននោះ គ្មានអ្វីទៅ OpenAI ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 내 Mac에서만 인식합니다. 그 전에는 아무것도 OpenAI로 보내지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Navnet gjenkjennes bare på Macen din; ingenting sendes til OpenAI før det."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jego imię jest rozpoznawane tylko na twoim Macu; wcześniej nic nie trafia do OpenAI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O nome dele é reconhecido só no seu Mac; nada vai para a OpenAI antes disso."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его имя распознаётся только на твоём Mac; до этого в OpenAI ничего не уходит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อของ Ginkgo ถูกจดจำบน Mac ของคุณเท่านั้น ก่อนหน้านั้นไม่มีอะไรถูกส่งไปที่ OpenAI"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adı yalnızca Mac'inde tanınır; öncesinde OpenAI'a hiçbir şey gitmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його ім’я розпізнається лише на твоєму Mac; до того нічого не йде до OpenAI."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它的名字只在你的 Mac 上识别；在此之前不会向 OpenAI 发送任何内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它的名字只在你的 Mac 上辨識；在此之前不會向 OpenAI 傳送任何內容。"
          }
        }
      }
    },
    "treelab.privacy.microphone": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الميكروفون: سيطلبه منك Ginkgo في أول محادثة لك، ليسمعك. لا يستمع Treelab أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon: Ginkgo će te pitati za njega pri prvom razgovoru, da te čuje. Treelab nikad ne sluša."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen: Ginkgo beder dig om den ved din første samtale for at kunne høre dig. Treelab lytter aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Mikrofon: Ginkgo fragt dich beim ersten Gespräch danach, um dich zu hören. Treelab hört nie zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The microphone: Ginkgo will ask you for it at your first conversation, to hear you. Treelab never listens."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El micrófono: Ginkgo te lo pedirá en tu primera conversación, para oírte. Treelab nunca escucha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le micro : Ginkgo te le demandera à ta première conversation, pour t’entendre. Treelab n’écoute jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il microfono: Ginkgo te lo chiederà alla tua prima conversazione, per sentirti. Treelab non ascolta mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マイク：Ginkgo は最初の会話のとき、あなたの声を聞くためにマイクの許可を求めます。Treelab が聞くことはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "មីក្រូហ្វូន៖ Ginkgo នឹងសុំវាពីអ្នកនៅការសន្ទនាលើកដំបូង ដើម្បីឮអ្នក។ Treelab មិនដែលស្តាប់ទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "마이크: Ginkgo가 첫 대화 때 내 목소리를 들으려고 마이크 권한을 요청합니다. Treelab은 절대 듣지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofonen: Ginkgo ber deg om den ved den første samtalen, for å høre deg. Treelab lytter aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon: Ginkgo poprosi cię o niego przy pierwszej rozmowie, żeby cię słyszeć. Treelab nigdy nie słucha."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O microfone: o Ginkgo vai pedir acesso a ele na sua primeira conversa, para ouvir você. O Treelab nunca ouve."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Микрофон: Ginkgo попросит доступ к нему при первом разговоре, чтобы слышать тебя. Treelab никогда не слушает."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไมโครโฟน: Ginkgo จะขออนุญาตใช้ไมโครโฟนในการสนทนาครั้งแรกของคุณ เพื่อให้ได้ยินคุณ Treelab ไม่ฟังเสียงคุณเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikrofon: Ginkgo seni duyabilmek için ilk sohbetinde ona erişim isteyecek. Treelab asla dinlemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мікрофон: Ginkgo попросить доступ до нього під час першої розмови, щоб чути тебе. Treelab ніколи не слухає."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "麦克风：Ginkgo 会在你第一次对话时请求使用它，以便听到你。Treelab 从不收听。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "麥克風：Ginkgo 會在你第一次對話時請求使用它，以便聽到你。Treelab 從不收聽。"
          }
        }
      }
    },
