    "treelab.welcome.trial.nextVersion": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يأتي تسجيل الدخول مع الإصدار القادم من treelab. يمكنك الاشتراك من الآن عبر الإعدادات."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijava stiže sa sljedećom verzijom alata treelab. Već se možeš pretplatiti iz postavki."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Login kommer med næste version af treelab. Du kan allerede abonnere fra indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldung kommt mit der nächsten Version von treelab. Abonnieren kannst du schon in den Einstellungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Signing in comes with the next version of treelab. You can already subscribe from the settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El inicio de sesión llega con la próxima versión de treelab. Ya puedes suscribirte desde los ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion arrive avec la prochaine version de treelab. Tu peux déjà t’abonner depuis les réglages."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accesso arriva con la prossima versione di treelab. Puoi già abbonarti dalle impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "サインインは次のバージョンの treelab で登場します。サブスクリプション登録はすでに設定から行えます。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "ការចូលនឹងមកជាមួយកំណែបន្ទាប់របស់ treelab។ អ្នកអាចជាវពីការកំណត់បានរួចហើយ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "로그인은 다음 버전의 treelab에서 제공됩니다. 구독은 지금도 설정에서 할 수 있습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Pålogging kommer med neste versjon av treelab. Du kan allerede abonnere fra innstillingene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Logowanie pojawi się w następnej wersji treelab. Subskrypcję możesz już wykupić w ustawieniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O login chega com a próxima versão do treelab. Você já pode assinar pelos ajustes."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход появится в следующей версии treelab. Подписаться уже можно в настройках."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้าใช้จะมาในเวอร์ชันถัดไปของ treelab ตอนนี้คุณสมัครสมาชิกจากการตั้งค่าได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oturum açma treelab'ın bir sonraki sürümüyle geliyor. Şimdiden ayarlardan abone olabilirsin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід з’явиться в наступній версії treelab. Підписатися вже можна в параметрах."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录功能将随下一版 treelab 推出。你现在已经可以在设置中订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登入功能將隨下一版 treelab 推出。你現在已經可以在設定中訂閱。"
          }
        }
      }
    },
    "treelab.welcome.trial.noCard": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دون بطاقة. لا يُقتطع أي مبلغ عند انتهاء التجربة."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez kartice. Kad proba završi, ništa se ne naplaćuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden kort. Der trækkes intet, når prøveperioden slutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Karte. Am Ende der Testphase wird nichts abgebucht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No card. Nothing is charged when the trial ends."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin tarjeta. No se cobra nada al terminar la prueba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans carte. Rien n’est prélevé à la fin de l’essai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza carta. Alla fine della prova non ti viene addebitato niente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードは不要です。トライアル終了時に料金は発生しません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានកាត។ គ្មានការគិតប្រាក់ទេ នៅពេលការសាកល្បងចប់។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드가 필요 없습니다. 체험이 끝나도 요금이 청구되지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten kort. Ingenting trekkes når prøveperioden slutter."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez karty. Po zakończeniu okresu próbnego nic nie zostanie pobrane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem cartão. Nada é cobrado quando o teste termina."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без карты. Когда пробный период закончится, ничего не спишется."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ต้องใช้บัตร เมื่อสิ้นสุดช่วงทดลองใช้จะไม่มีการเรียกเก็บเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kart yok. Deneme bittiğinde hiçbir ücret alınmaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без картки. Коли пробний період закінчиться, нічого не буде списано."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需信用卡。试用结束时不会扣费。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無需信用卡。試用結束時不會扣款。"
          }
        }
      }
    },
