          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜 마이크가 필요할까요?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜマイクが必要？"
          }
        }
      }
    },
    "treelab.welcome.ginkgo.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, your voice to steer your lanes"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, ta voix pour piloter tes couloirs"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, deine Stimme, um deine Spuren zu steuern"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, tu voz para dirigir tus carriles"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo، صوتك لقيادة مساراتك"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo，用你的声音掌控你的通道"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo，用你的聲音掌控你的通道"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, 목소리로 통로를 조종하세요"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo、声でレーンを操作"
          }
        }
      }
    },
    "treelab.welcome.intro": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab moves your projects forward with Claude, one piece of work at a time, and tells you only when it needs you. Four words to know:"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab fait avancer tes projets avec Claude, chantier par chantier, et te dit seulement quand il a besoin de toi. Quatre mots à connaître :"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab bringt deine Projekte mit Claude voran, ein Vorhaben nach dem anderen, und meldet sich nur, wenn es dich braucht. Vier Wörter, die du kennen solltest:"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab hace avanzar tus proyectos con Claude, un trabajo cada vez, y solo te avisa cuando te necesita. Cuatro palabras que conviene conocer:"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يدفع Treelab مشاريعك إلى الأمام مع Claude، عملًا تلو الآخر، ولا يخبرك إلا عندما يحتاج إليك. أربع كلمات عليك معرفتها:"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 借助 Claude 推进你的项目，一次一项工作，只在需要你时才告诉你。需要了解的四个词："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab 藉助 Claude 推進你的專案，一次一項工作，只在需要你時才告訴你。需要了解的四個詞："
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab은 Claude와 함께 프로젝트를 한 작업씩 진행하고, 내가 필요할 때만 알려 줍니다. 알아 둘 네 단어:"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Treelab は Claude と一緒に作業をひとつずつ進めてプロジェクトを前に進め、あなたが必要なときだけ知らせます。知っておきたい 4 つの言葉："
          }
        }
      }
    },
