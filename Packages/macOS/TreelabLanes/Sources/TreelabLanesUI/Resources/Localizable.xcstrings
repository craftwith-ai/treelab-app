    "treelab.account.cardOnStripe": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُدخل بطاقتك في صفحة Stripe الآمنة، في متصفحك: لا يراها Treelab أبدًا."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Karticu unosiš na sigurnoj Stripe stranici, u svom pregledniku: Treelab je nikad ne vidi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du indtaster dit kort på Stripes sikre side i din browser: Treelab ser det aldrig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du gibst deine Karte auf der sicheren Seite von Stripe in deinem Browser ein: Treelab sieht sie nie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You type your card on Stripe’s secure page, in your browser: Treelab never sees it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribes tu tarjeta en la página segura de Stripe, en tu navegador: Treelab nunca la ve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu tapes ta carte sur la page sécurisée de Stripe, dans ton navigateur : Treelab ne la voit jamais."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la carta sulla pagina sicura di Stripe, nel tuo browser: Treelab non la vede mai."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カード情報はブラウザで Stripe の安全なページに入力します。Treelab がそれを見ることはありません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "អ្នកវាយលេខកាតរបស់អ្នកនៅលើទំព័រសុវត្ថិភាពរបស់ Stripe ក្នុងកម្មវិធីរុករករបស់អ្នក៖ Treelab មិនដែលឃើញវាទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드 정보는 브라우저에서 Stripe 보안 페이지에 입력합니다: Treelab은 절대 보지 못합니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du skriver inn kortet ditt på Stripes sikre side, i nettleseren din: Treelab ser det aldri."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartę wpisujesz na bezpiecznej stronie Stripe, w swojej przeglądarce: Treelab nigdy jej nie widzi."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você digita o cartão na página segura da Stripe, no seu navegador: o Treelab nunca o vê."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Карту ты вводишь на защищённой странице Stripe, в своём браузере: Treelab её никогда не видит."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณกรอกข้อมูลบัตรบนหน้าที่ปลอดภัยของ Stripe ในเบราว์เซอร์ของคุณ: Treelab ไม่เห็นข้อมูลบัตรเลย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kartını tarayıcında, Stripe'ın güvenli sayfasına girersin: Treelab onu asla görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Картку ти вводиш на захищеній сторінці Stripe, у своєму браузері: Treelab її ніколи не бачить."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在浏览器里的 Stripe 安全页面上输入卡号：Treelab 永远看不到它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你在瀏覽器裡的 Stripe 安全頁面上輸入卡號：Treelab 永遠看不到它。"
          }
        }
      }
    },
