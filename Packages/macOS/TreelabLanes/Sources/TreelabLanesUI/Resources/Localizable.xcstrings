    "treelab.privacy.listen.key.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يستمع Ginkgo ما دمت تضغط المفتاح، ولا ثانية أكثر."
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo sluša dok držiš tipku, ni sekundu duže."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo lytter, så længe du holder tasten nede, ikke et sekund længere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo hört zu, solange du die Taste gedrückt hältst, keine Sekunde länger."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo listens while you hold the key, not a second longer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo escucha mientras mantienes pulsada la tecla, ni un segundo más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo écoute tant que tu tiens la touche, pas une seconde de plus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ascolta finché tieni premuto il tasto, non un secondo di più."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo はキーを押している間だけ聞き、1 秒たりとも長くは聞きません。"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo ស្តាប់ដរាបណាអ្នកសង្កត់គ្រាប់ចុច មិនលើសមួយវិនាទីទេ។"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo는 키를 누르고 있는 동안만 듣고, 1초도 더 듣지 않습니다."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo lytter så lenge du holder tasten inne, ikke et sekund lenger."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo słucha, dopóki trzymasz klawisz, ani sekundy dłużej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Ginkgo ouve enquanto você segura a tecla, nem um segundo a mais."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo слушает, пока ты держишь клавишу, ни секундой дольше."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo จะฟังเฉพาะตอนที่คุณกดแป้นค้างไว้ ไม่เกินแม้แต่วินาทีเดียว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo, sen tuşu basılı tuttuğun sürece dinler, bir saniye bile fazla değil."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginkgo слухає, поки ти тримаєш клавішу, ні секундою довше."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你按住按键时 Ginkgo 才会听，多一秒都不会。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只在你按住按鍵時 Ginkgo 才會聽，多一秒都不會。"
          }
        }
      }
    },
    "treelab.privacy.listen.name": {
      "comment": "Listening mode.",
      "extractionState": "manual",
      "localizations": {
        "ar": {
