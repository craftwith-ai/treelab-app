    "treelab.ginkgo.mic.off.detail": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا شيء يُسمع، ولا شيء يُرسل"
          }
        },
        "bs": {
          "stringUnit": {
            "state": "translated",
            "value": "ništa se ne čuje, ništa ne odlazi"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "intet høres, intet sendes"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "nichts wird gehört, nichts verlässt den Mac"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "nothing is heard, nothing leaves"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "no se escucha nada, no sale nada"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "rien n’est écouté, rien ne part"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "non si sente niente, non esce niente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "何も聞かず、何も送りません"
          }
        },
        "km": {
          "stringUnit": {
            "state": "translated",
            "value": "គ្មានអ្វីត្រូវបានឮ គ្មានអ្វីចេញទៅទេ"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아무것도 듣지 않고, 아무것도 나가지 않습니다"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "ingenting høres, ingenting sendes"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "nic nie słychać, nic nie wychodzi"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "nada é ouvido, nada sai"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "ничего не слышно, ничего не уходит"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่ได้ยินอะไร ไม่มีอะไรถูกส่งออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "hiçbir şey duyulmaz, hiçbir şey gitmez"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "нічого не чути, нічого не йде назовні"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "什么都不听，什么都不发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "什麼都不聽，什麼都不傳送"
          }
        }
      }
    },
