    },
    "treelab.welcome.notifications.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stay told when a lane waits"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Être prévenu quand un couloir attend"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Erfahre, wenn eine Spur wartet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entérate cuando un carril espera"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اعرف عندما ينتظر مسار"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有通道在等你时收到通知"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有通道在等你時收到通知"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "통로가 기다릴 때 알림 받기"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "レーンが待っているときに通知を受け取る"
          }
        }
      }
    },
    "treelab.welcome.notifications.why": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Why? To know a lane is waiting for you, even when Treelab is behind another window. Only when you’re needed; never ads."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pourquoi ? Pour savoir qu’un couloir t’attend, même quand Treelab est derrière une autre fenêtre. Seulement quand on a besoin de toi ; jamais de publicité."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warum? Damit du weißt, dass eine Spur auf dich wartet, auch wenn Treelab hinter einem anderen Fenster liegt. Nur wenn du gebraucht wirst; nie Werbung."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Por qué? Para saber que un carril te espera, incluso cuando Treelab está detrás de otra ventana. Solo cuando se te necesita; nunca publicidad."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لماذا؟ لتعرف أن مسارًا ينتظرك، حتى عندما يكون Treelab خلف نافذة أخرى. فقط عندما نحتاج إليك؛ ولا إعلانات أبدًا."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为什么？即使 Treelab 在其他窗口后面，你也能知道有通道在等你。只在需要你时通知；绝无广告。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為什麼？即使 Treelab 在其他視窗後面，你也能知道有通道在等你。只在需要你時通知；絕無廣告。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "왜 필요할까요? Treelab이 다른 창 뒤에 있어도 통로가 나를 기다린다는 것을 알 수 있습니다. 내가 필요할 때만 알리며, 광고는 절대 없습니다."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "なぜ？Treelab がほかのウインドウの後ろにあっても、レーンがあなた待ちだとわかります。必要なときだけで、広告は一切ありません。"
          }
        }
      }
    },
